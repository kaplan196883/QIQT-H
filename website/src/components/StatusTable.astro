---
import katex from 'katex';
// Pre-render math at build time (robust — no client-side dependency).
const m = (tex) => katex.renderToString(tex, { throwOnError: false });

// What is proven vs. what is open. Each label is HTML (math already rendered).
const rows = [
  [`Araki relative entropy = Umegaki (finite case)`, 'ok', 'machine-checked'],
  [`Bounded Tomita–Takesaki: ${m('J')}, ${m('JRJ=2-R')}, ${m('\\Delta^{it}')}, strong continuity`, 'ok', 'machine-checked'],
  [`One-particle CGP relative entropy + positivity ${m('S(\\xi)\\ge 0')}`, 'ok', 'machine-checked'],
  [`Free-field modular flow ${m('\\Gamma(\\Delta^{it})')}, ${m('\\sigma_t(W(u))=W(\\Delta^{it}u)')}`, 'ok', 'machine-checked'],
  [`Coherent-state relative modular operator, Connes cocycle, entropy reduction`, 'ok', 'machine-checked'],
  [`Free-field Born measure: ${m('\\sigma')}-additive, Lorentz-covariant, consistent (${m('\\mathrm{Re}\\,D=0')}; ${m('D=0')} for orthogonal records)`, 'ok', 'machine-checked'],
  [`Metaselector (which record framework): no-go trilogy &mdash; capacity, symmetry & state each fail &mdash; + einselection (Zurek); Born-from-projectors ${m('\\|P_r\\Phi\\|^2')}`, 'ok', 'machine-checked'],
  [`Area floor ${m('S_{\\rm vN}(\\rho_R)\\le Q_R')} &mdash; <em>derived</em> from finiteness (<code>area_floor_vonNeumann</code>)`, 'ok', 'machine-checked'],
  [`Finite capacity (P4): the postulate is <em>finiteness</em>; the area <em>form</em> ${m('\\propto A')} + the ${m('1/4')} come conditionally via the Sakharov bridge`, 'post', 'postulate + conditional form'],
  [`Geometric area-<em>scaling</em> ${m('S \\propto A_{\\rm geom}')} (area, not volume): proven for the boundary-local model (volume-law guard); for the actual free-field vacuum it is <em>known physics</em> (Srednicki/BKLS), <em>not yet formalized</em>`, 'post', 'known-but-unformalized · campaign-scoped'],
  [`Single record from λ (not from capacity — "Q_R forbids two records" is a category error)`, 'open', 'selection postulate'],
  [`Born statistics from typicality &mdash; reduced to a typicality postulate P5 (<a href="/papers">paper</a>); not "open"`, 'cond', 'reduced to P5'],
];
---
<table class="tbl">
  <thead><tr><th>Component</th><th>Status</th></tr></thead>
  <tbody>
    {rows.map(([label, tag, text]) => (
      <tr>
        <td set:html={label}></td>
        <td><span class={`tag ${tag}`}>{text}</span></td>
      </tr>
    ))}
  </tbody>
</table>
