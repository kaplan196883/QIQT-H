---
import katex from 'katex';
// Render each label's math to HTML at build time (robust — no client-side dependency).
const m = (tex) => katex.renderToString(tex, { throwOnError: false });

// The argument in five links. Each link carries its honest status colour.
const links = [
  { n: '1 · Holography',
    t: `A bounded region ${m('R')} has finite information capacity ${m('Q_R = A/4\\ell_P^2')} — the finite record <em>stage</em> (a bound on how many distinguishable records exist, not on the wave function). It is scaffolding, not the single-outcome mechanism: machine-checked, λ's measure uses only this <em>finiteness</em>, not the area value.`,
    cls: 's-postulate', tag: 'Postulate (FQ) · stage' },
  { n: '2 · Regional cost',
    t: `Regional content is a state on the Type II algebra; cost = Araki relative entropy ${m('\\chi_R')}.`,
    cls: 's-verified', tag: 'Calculus verified' },
  { n: '3 · Decoherence',
    t: `Standard unitary decoherence makes the macroscopic records non-interfering and redundantly objective; <em>einselection</em> (the interaction Hamiltonian) fixes <em>which</em> record framework — machine-checked as a no-go trilogy (capacity, symmetry, and the state Φ each provably fail to select it; the interaction does). But this removes interference and fixes the framework — it does not make one record actual.`,
    cls: 's-verified', tag: 'Standard QM' },
  { n: '4 · Single record',
    t: `A non-dynamical selector λ makes exactly one record actual; Φ stays exactly unitary. Its <em>selection schema</em> is machine-checked (finite → free field): the Takesaki criterion fixes which record context, the dephasing map is <em>modular-invariant</em> (a consistency fact — modular flow ≠ physical time), and an explicit inverse-CDF constructor picks <em>exactly one</em> record per actuality seed with seed-measure = Born weight. It's a verified schema, not a law: the single outcome is λ's, and the irreducible primitive is just <em>which seed is actual</em>.`,
    cls: 's-conditional', tag: 'Selection schema (λ) · verified' },
  { n: '5 · Born',
    t: `Probabilities ${m('|c_k|^2')} from typicality — machine-checked down to a no-signaling / reversibility postulate, with a no-go on anything weaker; not yet derived.`,
    cls: 's-open', tag: 'Open · reduced' },
];
---
<div class="chain">
  {links.map((l) => (
    <div class="link">
      <div class="n">{l.n}</div>
      <div class="t" set:html={l.t}></div>
      <span class={`pill ${l.cls}`}><span class="dot"></span>{l.tag}</span>
    </div>
  ))}
</div>
