/-! ### 1. ★ The reusable width-`w` full-leviSeries COLUMN engine (tail + k = 1 term). -/

/-- **★ `leviSeries_full_col_of_tail` — the width-`w` full signed Levi-series column bound.**  The
    signed series splits as `leviSeries E = (leviSeries E + E) − E`: the first summand is the k ≥ 2
    tail (bounded by `C_os·(s·G_{ws})`, `O(s)` — the width-generic `bridgeGeneric_tail_O_s_w`
    shape), the second is the k = 1 term `E` (bounded by `C_U·G_{ws}` — the O(1) column bound
    `hEuni`).  On `(0,1]` the extra `s ≤ 1` collapses the tail's `s` factor, giving the CLEAN width-
    `w` column `hBdom` shape `|leviSeries E s p 0| ≤ (C_os + C_U)·G_{ws}`.  Width-generic,
    witness-generic; consumes only the two banked column shapes.  NOT `a₁ = R/6`. -/
theorem leviSeries_full_col_of_tail (E : ℝ → Point n → Point n → ℝ) (w C_os C_U : ℝ)
    (hCos : 0 ≤ C_os) (hCU : 0 ≤ C_U)
    (htail : ∀ (s : ℝ) (p : Point n), 0 < s → s ≤ 1 →
      |leviSeries E s p 0 + E s p 0| ≤ C_os * (s * gaussDdim (w * s) (p - 0)))
    (hEcol : ∀ (s : ℝ) (p : Point n), 0 < s → s ≤ 1 →
      |E s p 0| ≤ C_U * gaussDdim (w * s) (p - 0)) :
    ∃ C_L : ℝ, 0 ≤ C_L ∧ ∀ (s : ℝ) (p : Point n), 0 < s → s ≤ 1 →
      |leviSeries E s p 0| ≤ C_L * gaussDdim (w * s) (p - 0) := by
  refine ⟨C_os + C_U, add_nonneg hCos hCU, fun s p hs hs1 => ?_⟩
  have hG : 0 ≤ gaussDdim (w * s) (p - 0) := QIQTH.ResidueBound.gaussDdim_nonneg _ _
  have htl := htail s p hs hs1
  have hE := hEcol s p hs hs1
  -- triangle split: |leviSeries| ≤ |leviSeries + E| + |E|
  have hsplit : |leviSeries E s p 0| ≤ |leviSeries E s p 0 + E s p 0| + |E s p 0| := by
    calc |leviSeries E s p 0|
        = |(leviSeries E s p 0 + E s p 0) + (-(E s p 0))| := by
          rw [show (leviSeries E s p 0 + E s p 0) + (-(E s p 0)) = leviSeries E s p 0 from by ring]
      _ ≤ |leviSeries E s p 0 + E s p 0| + |(-(E s p 0))| := abs_add_le _ _
      _ = |leviSeries E s p 0 + E s p 0| + |E s p 0| := by rw [abs_neg]
  -- collapse the tail's `s ≤ 1` factor
  have hos : C_os * (s * gaussDdim (w * s) (p - 0)) ≤ C_os * gaussDdim (w * s) (p - 0) := by
    refine mul_le_mul_of_nonneg_left ?_ hCos
    calc s * gaussDdim (w * s) (p - 0) ≤ 1 * gaussDdim (w * s) (p - 0) :=
          mul_le_mul_of_nonneg_right hs1 hG
      _ = gaussDdim (w * s) (p - 0) := one_mul _
  calc |leviSeries E s p 0|
      ≤ |leviSeries E s p 0 + E s p 0| + |E s p 0| := hsplit
    _ ≤ C_os * (s * gaussDdim (w * s) (p - 0)) + C_U * gaussDdim (w * s) (p - 0) :=
        add_le_add htl hE
    _ ≤ C_os * gaussDdim (w * s) (p - 0) + C_U * gaussDdim (w * s) (p - 0) :=
        add_le_add hos (le_refl _)
    _ = (C_os + C_U) * gaussDdim (w * s) (p - 0) := by ring

/-! ### 2. ★ The whitened instantiation — the full-leviSeries column at width `lam`. -/

/-- **★ `white_leviSeries_full_col` — the full whitened Levi-series column bound at width `lam`.**
    `WhiteBridge.white_tail_O_s` (the k ≥ 2 tail) and `WhiteBridge.white_hEuni` (the k = 1 O(1)
    column term, slice `q = 0`) fed into `leviSeries_full_col_of_tail`.  CONDITIONAL on the pkg
    bound `+` the carried S1 measurability — exactly as `white_tail_O_s`.  Width `lam`, NO `lam ≤ 8`.
    NOT `a₁ = R/6`. -/
theorem white_leviSeries_full_col (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (S : Point n → Set (Point n)) (a b C lam : ℝ)
    (hC : 0 ≤ C) (hlam2 : 2 ≤ lam)
    (hpkg : ∀ t' τ : ℝ, ∀ p q : Point n, 0 < τ → τ ≤ t' →
      |heatOp (curvedRNCMetric κ) (curvedRNCInv κ)
          (whiteGatedWitness κ hκ hKc S a b) τ p q|
        ≤ (C * (1 + t')) * baseKernelW lam 0 τ p q)
    (hEmeas : QIQTH.HEmeasBorelAudit.tripleHEmeas (curvedRNCMetric κ) (curvedRNCInv κ)
      (whiteGatedWitness κ hκ hKc S a b)) :
    ∃ C_L : ℝ, 0 ≤ C_L ∧ ∀ (s : ℝ) (p : Point n), 0 < s → s ≤ 1 →
      |leviSeries (whiteDefectKernel κ hκ hKc S a b) s p 0|
        ≤ C_L * gaussDdim (lam * s) (p - 0) := by
  obtain ⟨C_os, hCos, htail⟩ := white_tail_O_s κ hκ hKc S a b C lam hC hlam2 hpkg hEmeas
  refine leviSeries_full_col_of_tail (whiteDefectKernel κ hκ hKc S a b) lam C_os (2 * C)
    hCos (by linarith) htail ?_
  intro s p hs hs1
  exact white_hEuni κ hκ hKc S a b C lam hpkg s p 0 hs hs1

/-- **★★ `white_hBdom_col_discharged` — THE FEED (column form).**  For EVERY `κ ≤ 0` and compact
    `K ⊆ B̄(0,R)` there ARE a fat open gate `S`, radii `0 < a < b`, and a width `lam ≥ 2` such that,
    MODULO exactly ONE labelled input — the S1 joint measurability of the whitened defect — the FULL
    whitened signed Levi-series COLUMN obeys `|leviSeries (whiteDefectKernel …) s p 0| ≤ C_L·G_{lam·s}`
    on `(0,1]`.  Every Gaussian-domination / integrability slot is UNCONDITIONALLY discharged from
    J4-626's `white_hpkgBound_discharged`.  ⚠ HONEST WIDTH `lam = whiteLam` (opaque `C₀`); the
    conclusion is at `G_{lam·s}` — NO `lam ≤ 8` used.  This is the width-`lam` analogue of the COLUMN
    of `CurvedA1ReBaseHBdom.gated_hBdom_of_defect_bound`, at the WHITENED witness.  NOT `a₁ = R/6`. -/
theorem white_hBdom_col_discharged (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (R : ℝ) (hKb : Kset ⊆ Metric.closedBall (0 : Point n) R) :
    ∃ S : Point n → Set (Point n), ∃ a b : ℝ, 0 < a ∧ a < b
      ∧ (∀ q ∈ Kset, q ∈ S q ∧ IsOpen (S q))
      ∧ ∃ lam : ℝ, 2 ≤ lam ∧
        (QIQTH.HEmeasBorelAudit.tripleHEmeas (curvedRNCMetric κ) (curvedRNCInv κ)
            (whiteGatedWitness κ hκ hKc S a b) →
          ∃ C_L : ℝ, 0 ≤ C_L ∧ ∀ (s : ℝ) (p : Point n), 0 < s → s ≤ 1 →
            |leviSeries (whiteDefectKernel κ hκ hKc S a b) s p 0|
              ≤ C_L * gaussDdim (lam * s) (p - 0)) := by
  obtain ⟨S, a, b, ha, hab, hgate, C, hC0, lam, hlam2, hpkg⟩ :=
    white_hpkgBound_discharged κ hκ hKc R hKb
  exact ⟨S, a, b, ha, hab, hgate, lam, hlam2,
    fun hEmeas => white_leviSeries_full_col κ hκ hKc S a b C lam hC0 hlam2 hpkg hEmeas⟩

/-! ### 3. ★ The R2 / width-alignment verdict (re-export). -/

/-- **★ `white_hBdom_col_width_verdict` — the R2 verdict.**  The width `lam = whiteLam` of the
    discharged column `hBdom` satisfies `2 ≤ whiteLam` ALWAYS, and `whiteLam ≤ 8 ↔ n·C₀² ≤ 3`
    (`WhiteGated.whiteLam_le_eight_iff`).  ⚠ HONEST: `C₀ = uniformFlowConst …` is opaque
    (`.choose`), only `C₀ ≥ 0` banked, so `n·C₀² ≤ 3` is a GENUINE undecided width-alignment
    condition — but it is NOT needed by the column `hBdom` above (width-parametric `G_{lam·s}`); it
    is required ONLY by the frozen-`G_{8s}` bridge comparison.  NOT `a₁ = R/6`. -/
theorem white_hBdom_col_width_verdict (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    2 ≤ whiteLam κ hκ hKc ∧
    ((whiteLam κ hκ hKc ≤ 8)
      ↔ ((n : ℝ) * (uniformFlowConst (curvedRNCMetric κ) (curvedRNCInv κ)
          (curvedRNC_hChr κ hκ) hKc) ^ 2 ≤ 3)) :=
  ⟨whiteLam_ge_two κ hκ hKc, whiteLam_le_eight_iff κ hκ hKc⟩

/-! ### 4. Non-vacuity / adversarial gate (cp466 discipline). -/

/-- **Non-vacuity gate** — at genuinely curved data (`n = 2`, `κ = −1`, `K = closedBall 0 2`): the
    ∃-package of `white_hBdom_col_discharged` produces a FAT gate (`q ∈ S q`, open, at `q ∈ K ≠ ∅`)
    with `0 < a < b` and `lam ≥ 2` — the antecedent chain up to the single S1 input is genuinely
    satisfiable, not `∅`-degenerate.  NOT `a₁ = R/6`. -/
theorem white_hBdom_col_feed_witness_gate :
    ∃ S : Point 2 → Set (Point 2), ∃ a b : ℝ, 0 < a ∧ a < b
      ∧ ((0 : Point 2) ∈ S 0 ∧ IsOpen (S 0))
      ∧ ∃ lam : ℝ, 2 ≤ lam := by
  obtain ⟨S, a, b, ha, hab, hgate, lam, hlam2, -⟩ :=
    white_hBdom_col_discharged (n := 2) (-1 : ℝ) (by norm_num)
      (isCompact_closedBall (0 : Point 2) 2) 2 (subset_refl _)
  exact ⟨S, a, b, ha, hab,
    hgate 0 (Metric.mem_closedBall_self (by norm_num)), lam, hlam2⟩

end QIQTH.WhiteHBdomReconcile

