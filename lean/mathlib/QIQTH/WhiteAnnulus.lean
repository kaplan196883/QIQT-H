/-! ### 0. Symmetry of the whitened pair (the `hgisymm` supplier of the Leibniz split). -/

/-- The whitened pullback metric is SYMMETRIC — the base symmetry `g̃ = g̃ᵀ` conjugated by the
    whitening frame (index swap + `Finset.sum_comm`). -/
theorem whitePullbackMetric_symm (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (q w : Point n) (i j : Fin n) :
    whitePullbackMetric κ hκ hKc q w i j = whitePullbackMetric κ hκ hKc q w j i := by
  simp only [whitePullbackMetric]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
  rw [uniformFlowPullbackMetric_symm (curvedRNCMetric κ) (curvedRNCInv κ)
    (curvedRNC_hChr κ hκ) hKc (fun y c d => curvedRNCMetric_symm κ y c d) q
    (whiteVel κ q w) b a,
    curvedWhitening_symm κ q i b, curvedWhitening_symm κ q a j]
  ring

/-- The whitened pullback INVERSE metric is symmetric GLOBALLY (unit case via the banked
    `invMat_symm`; non-unit case both sides are the `Ring.inverse` junk value `0`). -/
theorem whitePullbackMetricInv_symm_global (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (q w : Point n) (i j : Fin n) :
    whitePullbackMetricInv κ hκ hKc q w i j = whitePullbackMetricInv κ hκ hKc q w j i := by
  by_cases hU : IsUnit (matToCLM (fun a b => whitePullbackMetric κ hκ hKc q w a b))
  · simpa only [whitePullbackMetricInv] using
      invMat_symm (fun a b => whitePullbackMetric κ hκ hKc q w a b) hU
        (fun a b => whitePullbackMetric_symm κ hκ hKc q w a b) i j
  · simp only [whitePullbackMetricInv, Ring.inverse_non_unit _ hU,
      ContinuousLinearMap.zero_apply, Pi.zero_apply]

/-! ### 1. The whitening-inverse algebra + norm bound (the gate-certificate suppliers). -/

/-- The whitened velocity UNDOES the explicit inverse: `E_q (E_q⁻¹ v) = v`. -/
theorem whiteVel_whiteUnvel (κ : ℝ) (hκ : κ ≤ 0) (q v : Point n) :
    whiteVel κ q (whiteUnvel κ q v) = v := by
  have h := congrArg (fun T : Point n →L[ℝ] Point n => T v) (whiteVel_mul_whiteUnvel κ hκ q)
  simpa only [ContinuousLinearMap.mul_apply, ContinuousLinearMap.one_apply,
    matToCLM_curvedWhitening_apply] using h

/-- The whitened chart at the inverse velocity is the RAW uniform-flow chart:
    `whiteExp_q (E_q⁻¹ v) = uniformFlowExp_q v`. -/
theorem whiteExp_whiteUnvel (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (q v : Point n) :
    whiteExp κ hκ hKc q (whiteUnvel κ q v)
      = uniformFlowExp (curvedRNCMetric κ) (curvedRNCInv κ) (curvedRNC_hChr κ hκ) hKc q v := by
  show uniformFlowExp (curvedRNCMetric κ) (curvedRNCInv κ) (curvedRNC_hChr κ hκ) hKc q
      (whiteVel κ q (whiteUnvel κ q v)) = _
  rw [whiteVel_whiteUnvel κ hκ q v]

/-- Compactness entry bound for the curved metric over the compact base set. -/
theorem curvedRNCMetric_bound_on_compact (κ : ℝ) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    ∃ Mg : ℝ, 0 ≤ Mg ∧ ∀ q ∈ Kset, ∀ i j : Fin n, |curvedRNCMetric κ q i j| ≤ Mg := by
  classical
  have hbd : ∀ i j : Fin n, ∃ M : ℝ, 0 ≤ M ∧ ∀ q ∈ Kset, |curvedRNCMetric κ q i j| ≤ M := by
    intro i j
    obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn
      ((curvedRNCMetric_contDiff κ i j).continuous.continuousOn)
    refine ⟨max M 0, le_max_right _ _, fun q hq => ?_⟩
    have h := hM q hq
    rw [Real.norm_eq_abs] at h
    exact h.trans (le_max_left _ _)
  choose M hM0 hMbd using hbd
  refine ⟨∑ i, ∑ j, M i j,
    Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => hM0 i j, ?_⟩
  intro q hq i j
  refine (hMbd i j q hq).trans ?_
  calc M i j ≤ ∑ j', M i j' :=
        Finset.single_le_sum (f := fun j' => M i j') (fun j' _ => hM0 i j') (Finset.mem_univ j)
    _ ≤ ∑ i', ∑ j', M i' j' :=
        Finset.single_le_sum (f := fun i' => ∑ j', M i' j')
          (fun i' _ => Finset.sum_nonneg fun j' _ => hM0 i' j') (Finset.mem_univ i)

/-- **The whitening-inverse norm bound** `‖E_q⁻¹ v‖ ≤ C_E·‖v‖`, uniform over `q ∈ K`:
    `E_q⁻¹ = g^κ(q)·E_q` has entries `≤ n·M_g` (metric entries compactness-bounded, whitening
    entries `≤ 1`), so the sup-norm operator bound is `n²·M_g`. -/
theorem whiteUnvel_norm_le (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    ∃ CE : ℝ, 0 ≤ CE ∧ ∀ q ∈ Kset, ∀ v : Point n, ‖whiteUnvel κ q v‖ ≤ CE * ‖v‖ := by
  obtain ⟨Mg, hMg0, hMg⟩ := curvedRNCMetric_bound_on_compact κ hKc
  refine ⟨(n : ℝ) ^ 2 * Mg, by positivity, ?_⟩
  intro q hq v
  rw [pi_norm_le_iff_of_nonneg (by positivity)]
  intro i
  rw [Real.norm_eq_abs]
  have hUv : whiteUnvel κ q v i
      = ∑ j, (∑ m, curvedRNCMetric κ q i m * curvedWhitening κ q m j) * v j :=
    matToCLM_apply _ v i
  rw [hUv]
  calc |∑ j, (∑ m, curvedRNCMetric κ q i m * curvedWhitening κ q m j) * v j|
      ≤ ∑ j, |(∑ m, curvedRNCMetric κ q i m * curvedWhitening κ q m j) * v j| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j : Fin n, ((n : ℝ) * Mg) * ‖v‖ := by
        refine Finset.sum_le_sum fun j _ => ?_
        rw [abs_mul]
        have h1 : |∑ m, curvedRNCMetric κ q i m * curvedWhitening κ q m j| ≤ (n : ℝ) * Mg := by
          calc |∑ m, curvedRNCMetric κ q i m * curvedWhitening κ q m j|
              ≤ ∑ m, |curvedRNCMetric κ q i m * curvedWhitening κ q m j| :=
                Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ _m : Fin n, Mg := by
                refine Finset.sum_le_sum fun m _ => ?_
                rw [abs_mul]
                calc |curvedRNCMetric κ q i m| * |curvedWhitening κ q m j|
                    ≤ Mg * 1 := mul_le_mul (hMg q hq i m)
                        (curvedWhitening_entry_abs_le_one κ hκ q m j) (abs_nonneg _) hMg0
                  _ = Mg := mul_one _
            _ = (n : ℝ) * Mg := by
                simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        have h2 : |v j| ≤ ‖v‖ := by
          have h := norm_le_pi_norm v j
          rwa [Real.norm_eq_abs] at h
        exact mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
    _ = (n : ℝ) ^ 2 * Mg * ‖v‖ := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

/-! ### 2. The whitened inverse-metric entry bound on the gate. -/

/-- `|ĝ⁻¹_q(w)ᵢⱼ| ≤ Gb` uniformly over `q ∈ K` on a uniform gate — the J4-622 dev bound + the
    δ triangle. -/
theorem whiteInv_entry_bound (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    ∃ r₀ > (0 : ℝ), ∃ Gb : ℝ, 0 ≤ Gb ∧ ∀ q ∈ Kset, ∀ w : Point n, ‖w‖ < r₀ → ∀ i j : Fin n,
      |whitePullbackMetricInv κ hκ hKc q w i j| ≤ Gb := by
  obtain ⟨r₁, hr₁0, M₁, hM₁0, hdev⟩ := whitePullbackMetricInv_dev_uniform κ hκ hKc
  refine ⟨r₁, hr₁0, 1 + M₁ * ((n : ℝ) * r₁ ^ 2), by positivity, ?_⟩
  intro q hq w hw i j
  have hr2b : rncRadialSq w ≤ (n : ℝ) * r₁ ^ 2 := by
    refine rncRadialSq_le_of_mem_closedBall (q := w) (r := r₁) ?_
    rw [Metric.mem_closedBall, dist_zero_right]
    exact hw.le
  have hd := hdev q hq w hw i j
  have hδ : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by
    by_cases h : i = j <;> simp [h]
  have htri : |whitePullbackMetricInv κ hκ hKc q w i j|
      ≤ |whitePullbackMetricInv κ hκ hKc q w i j - (if i = j then (1 : ℝ) else 0)|
        + |(if i = j then (1 : ℝ) else 0)| := by
    calc |whitePullbackMetricInv κ hκ hKc q w i j|
        = |(whitePullbackMetricInv κ hκ hKc q w i j - (if i = j then (1 : ℝ) else 0))
            + (if i = j then (1 : ℝ) else 0)| := by ring_nf
      _ ≤ _ := abs_add_le _ _
  have hmono : M₁ * rncRadialSq w ≤ M₁ * ((n : ℝ) * r₁ ^ 2) :=
    mul_le_mul_of_nonneg_left hr2b hM₁0
  linarith

/-! ### 3. Cutoff-derivative bounds on a GENERALIZED annulus (radii decoupled from the cutoff). -/

/-- `|∂ᵢχ_{a,b}| ≤ Kc1` on the annulus `[aL², bU²]` — radii DECOUPLED from the cutoff radii
    (compactness, χ is `C∞`). -/
theorem pd_radialCutoff_bound_on_annulus_gen (a b aL bU : ℝ) :
    ∃ Kc1 : ℝ, 0 ≤ Kc1 ∧ ∀ (w : Point n) (i : Fin n),
      aL ^ 2 ≤ rncRadialSq w → rncRadialSq w ≤ bU ^ 2 →
      |pd (radialCutoff a b) i w| ≤ Kc1 := by
  classical
  have hbd : ∀ i : Fin n, ∃ K : ℝ, 0 ≤ K ∧ ∀ w : Point n,
      aL ^ 2 ≤ rncRadialSq w → rncRadialSq w ≤ bU ^ 2 →
      |pd (radialCutoff a b) i w| ≤ K :=
    fun i => exists_bound_on_annulus (fun w => pd (radialCutoff a b) i w)
      (contDiff_pd_inf (radialCutoff a b) (radialCutoff_contDiff a b) i).continuous aL bU
  choose K hK0 hKbd using hbd
  refine ⟨∑ i, K i, Finset.sum_nonneg fun i _ => hK0 i, ?_⟩
  intro w i h1 h2
  exact (hKbd i w h1 h2).trans
    (Finset.single_le_sum (f := fun i' => K i') (fun i' _ => hK0 i') (Finset.mem_univ i))

/-- `|∂ᵢ∂ⱼχ_{a,b}| ≤ Kpp` on the annulus `[aL², bU²]` — radii decoupled. -/
theorem pd_pd_radialCutoff_bound_on_annulus_gen (a b aL bU : ℝ) :
    ∃ Kpp : ℝ, 0 ≤ Kpp ∧ ∀ (w : Point n) (i j : Fin n),
      aL ^ 2 ≤ rncRadialSq w → rncRadialSq w ≤ bU ^ 2 →
      |pd (fun y => pd (radialCutoff a b) j y) i w| ≤ Kpp := by
  classical
  have hbd : ∀ i j : Fin n, ∃ K : ℝ, 0 ≤ K ∧ ∀ w : Point n,
      aL ^ 2 ≤ rncRadialSq w → rncRadialSq w ≤ bU ^ 2 →
      |pd (fun y => pd (radialCutoff a b) j y) i w| ≤ K :=
    fun i j => exists_bound_on_annulus (fun w => pd (fun y => pd (radialCutoff a b) j y) i w)
      (contDiff_pd_inf (fun y => pd (radialCutoff a b) j y)
        (contDiff_pd_inf (radialCutoff a b) (radialCutoff_contDiff a b) j) i).continuous aL bU
  choose K hK0 hKbd using hbd
  refine ⟨∑ i, ∑ j, K i j,
    Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => hK0 i j, ?_⟩
  intro w i j h1 h2
  refine (hKbd i j w h1 h2).trans ?_
  calc K i j ≤ ∑ j', K i j' :=
        Finset.single_le_sum (f := fun j' => K i j') (fun j' _ => hK0 i j') (Finset.mem_univ j)
    _ ≤ ∑ i', ∑ j', K i' j' :=
        Finset.single_le_sum (f := fun i' => ∑ j', K i' j')
          (fun i' _ => Finset.sum_nonneg fun j' _ => hK0 i' j') (Finset.mem_univ i)

/-! ### 4. `|Δ_{ĝ_q}χ| ≤ K₂` on the gate annulus, uniform over `q ∈ K`. -/

/-- **The whitened Laplacian-of-cutoff bound** — `|Δ_{ĝ_q}χ_{a,b}(w)| ≤ K₂` uniformly over
    `q ∈ K` on the gate annulus `‖w‖ < r₀`, `a² ≤ rncRadialSq w`: `|ĝ⁻¹| ≤ Gb` (§2) ×
    (`|∂∂χ| ≤ Kpp` + `|Γ̂| ≤ C_Γ·r₀` × `|∂χ| ≤ Kc1`).  The gate radius is FIXED before the
    cutoff radii `(a,b)`. -/
theorem whiteChart_lapChi_bound (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    ∃ r₀ > (0 : ℝ), ∀ a b : ℝ, ∃ K2 : ℝ, 0 ≤ K2 ∧ ∀ q ∈ Kset, ∀ w : Point n, ‖w‖ < r₀ →
      a ^ 2 ≤ rncRadialSq w →
      |laplaceBeltrami (fun v => whitePullbackMetric κ hκ hKc q v)
          (fun v => whitePullbackMetricInv κ hκ hKc q v) (radialCutoff a b) w| ≤ K2 := by
  classical
  obtain ⟨r₁, hr₁0, Gb, hGb0, hgib⟩ := whiteInv_entry_bound κ hκ hKc
  obtain ⟨rΓ, hrΓ0, CΓ, hCΓ0, hΓ⟩ := whiteChart_christoffel_linear_uniform κ hκ hKc
  refine ⟨min r₁ rΓ, lt_min hr₁0 hrΓ0, ?_⟩
  intro a b
  obtain ⟨Kc1, hKc10, hKc1⟩ := pd_radialCutoff_bound_on_annulus_gen (n := n) a b a
    (Real.sqrt n * min r₁ rΓ)
  obtain ⟨Kpp, hKpp0, hKpp⟩ := pd_pd_radialCutoff_bound_on_annulus_gen (n := n) a b a
    (Real.sqrt n * min r₁ rΓ)
  have hr0' : 0 ≤ min r₁ rΓ := (lt_min hr₁0 hrΓ0).le
  have hCr0 : 0 ≤ CΓ * min r₁ rΓ := mul_nonneg hCΓ0 hr0'
  refine ⟨(n : ℝ) ^ 2 * (Gb * (Kpp + (n : ℝ) * ((CΓ * min r₁ rΓ) * Kc1))),
    mul_nonneg (by positivity) (mul_nonneg hGb0 (add_nonneg hKpp0
      (mul_nonneg (Nat.cast_nonneg n) (mul_nonneg hCr0 hKc10)))), ?_⟩
  intro q hq w hw hann
  have hw1 : ‖w‖ < r₁ := lt_of_lt_of_le hw (min_le_left _ _)
  have hwΓ : ‖w‖ < rΓ := lt_of_lt_of_le hw (min_le_right _ _)
  have hub : rncRadialSq w ≤ (Real.sqrt n * min r₁ rΓ) ^ 2 := by
    have h1 : rncRadialSq w ≤ (n : ℝ) * (min r₁ rΓ) ^ 2 := by
      refine rncRadialSq_le_of_mem_closedBall (q := w) (r := min r₁ rΓ) ?_
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hw.le
    have h2 : (Real.sqrt n * min r₁ rΓ) ^ 2 = (n : ℝ) * (min r₁ rΓ) ^ 2 := by
      rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg n)]
    linarith
  have hsub2 : ∀ x y : ℝ, |x - y| ≤ |x| + |y| := fun x y => by
    rw [sub_eq_add_neg]
    exact (abs_add_le x (-y)).trans_eq (by rw [abs_neg])
  have hterm : ∀ i j : Fin n,
      |pd (fun y => pd (radialCutoff a b) j y) i w
        - ∑ k, christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
            (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
            * pd (radialCutoff a b) k w|
      ≤ Kpp + (n : ℝ) * ((CΓ * min r₁ rΓ) * Kc1) := by
    intro i j
    have h1 : |pd (fun y => pd (radialCutoff a b) j y) i w| ≤ Kpp := hKpp w i j hann hub
    have h2 : |∑ k, christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
        (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
        * pd (radialCutoff a b) k w|
        ≤ (n : ℝ) * ((CΓ * min r₁ rΓ) * Kc1) := by
      calc |∑ k, christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
            (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
            * pd (radialCutoff a b) k w|
          ≤ ∑ k, |christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
              (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
              * pd (radialCutoff a b) k w| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _k : Fin n, (CΓ * min r₁ rΓ) * Kc1 := by
            refine Finset.sum_le_sum fun k _ => ?_
            rw [abs_mul]
            refine mul_le_mul ?_ (hKc1 w k hann hub) (abs_nonneg _) hCr0
            calc |christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
                  (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w|
                ≤ CΓ * ‖w‖ := hΓ q hq w hwΓ k i j
              _ ≤ CΓ * min r₁ rΓ := mul_le_mul_of_nonneg_left hw.le hCΓ0
        _ = (n : ℝ) * ((CΓ * min r₁ rΓ) * Kc1) := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have h3 := hsub2 (pd (fun y => pd (radialCutoff a b) j y) i w)
      (∑ k, christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
        (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
        * pd (radialCutoff a b) k w)
    linarith
  simp only [laplaceBeltrami]
  calc |∑ i, ∑ j, whitePullbackMetricInv κ hκ hKc q w i j
        * (pd (fun y => pd (radialCutoff a b) j y) i w
          - ∑ k, christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
              (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
              * pd (radialCutoff a b) k w)|
      ≤ ∑ i, ∑ j, |whitePullbackMetricInv κ hκ hKc q w i j
          * (pd (fun y => pd (radialCutoff a b) j y) i w
            - ∑ k, christoffel (fun v => whitePullbackMetric κ hκ hKc q v)
                (fun v => whitePullbackMetricInv κ hκ hKc q v) k i j w
                * pd (radialCutoff a b) k w)| :=
        (Finset.abs_sum_le_sum_abs _ _).trans
          (Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _)
    _ ≤ ∑ _i : Fin n, ∑ _j : Fin n,
          Gb * (Kpp + (n : ℝ) * ((CΓ * min r₁ rΓ) * Kc1)) := by
        refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
        rw [abs_mul]
        exact mul_le_mul (hgib q hq w hw1 i j) (hterm i j) (abs_nonneg _) hGb0
    _ = (n : ℝ) ^ 2 * (Gb * (Kpp + (n : ℝ) * ((CΓ * min r₁ rΓ) * Kc1))) := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

/-! ### 5. The EXACT chart transfer for the CUT kernel (the weld extends to `χ·W`). -/

/-- **★ The cut-kernel chart transfer** — on the gate `p = whiteExp_q w`, `‖w‖ < r₀` (radius
    INDEPENDENT of the cutoff radii), the ambient heat defect of the whitened CUTOFF kernel
    EQUALS the chart-side defect of the cutoff-carrying amplitude Gaussian:
        `heatOp g^κ gi^κ (whiteCutKernel a b) τ (whiteExp_q w) q
           = ∂_τ(χ(w)·√det·G_τ(w)) − Δ_{ĝ_q}(χ·(√det·G_τ))(w)`.
    The J4-624 naturality weld consumes ANY `C²` section; the cutoff section is `C²` at gate
    points (χ is `C∞`, the inverse chart is `C²` there).  NOT `a₁ = R/6`. -/
theorem whiteCut_heatOp_eq (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    ∃ r₀ > (0 : ℝ), ∀ a b : ℝ, ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ w : Point n, ‖w‖ < r₀ →
      heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteCutKernel κ hκ hKc a b) τ
          (whiteExp κ hκ hKc q w) q
        = deriv (fun u => radialCutoff a b w
            * (Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim u w)) τ
          - laplaceBeltrami (fun v => whitePullbackMetric κ hκ hKc q v)
              (fun v => whitePullbackMetricInv κ hκ hKc q v)
              (fun y => radialCutoff a b y
                * (Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y)) w := by
  classical
  obtain ⟨r₁, hr₁0, hweld⟩ := laplaceBeltrami_whiteExp_naturality κ hκ hKc
  obtain ⟨δ₀, hδ₀0, hpack⟩ := whiteInvChart_pack κ hκ hKc
  have hsn : (0 : ℝ) ≤ Real.sqrt n := Real.sqrt_nonneg _
  refine ⟨min r₁ (δ₀ / (Real.sqrt n + 1)), lt_min hr₁0 (by positivity), ?_⟩
  intro a b q hq τ hτ w hw
  have hw1 : ‖w‖ < r₁ := lt_of_lt_of_le hw (min_le_left _ _)
  have hvδ : ‖whiteVel κ q w‖ < δ₀ := by
    have h1 : ‖whiteVel κ q w‖ ≤ Real.sqrt n * ‖w‖ := whiteVel_norm_le κ hκ q w
    have h2 : ‖w‖ < δ₀ / (Real.sqrt n + 1) := lt_of_lt_of_le hw (min_le_right _ _)
    have h3 : Real.sqrt n * ‖w‖ ≤ (Real.sqrt n + 1) * ‖w‖ :=
      mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)
    have h4 : (Real.sqrt n + 1) * ‖w‖ < (Real.sqrt n + 1) * (δ₀ / (Real.sqrt n + 1)) :=
      mul_lt_mul_of_pos_left h2 (by positivity)
    have h5 : (Real.sqrt n + 1) * (δ₀ / (Real.sqrt n + 1)) = δ₀ := by field_simp
    linarith
  obtain ⟨hgerm, hC2⟩ := hpack q hq w hvδ
  have hval : whiteInvChart κ hκ hKc q (whiteExp κ hκ hKc q w) = w := hgerm.eq_of_nhds
  -- the cut ambient section is C² at the far point
  have h1 : ContDiffAt ℝ 2 (fun p' => whiteInvChart κ hκ hKc q p')
      (whiteExp κ hκ hKc q w) := by
    have hlin : ContDiffAt ℝ 2 (⇑(whiteUnvel κ q))
        (uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ) (curvedRNC_hChr κ hκ)
          hKc q (whiteExp κ hκ hKc q w)) := (whiteUnvel κ q).contDiff.contDiffAt
    exact hlin.comp _ hC2
  have hχ : ContDiffAt ℝ 2 (fun p' => radialCutoff a b (whiteInvChart κ hκ hKc q p'))
      (whiteExp κ hκ hKc q w) := by
    have hcut : ContDiffAt ℝ 2 (radialCutoff a b : Point n → ℝ)
        (whiteInvChart κ hκ hKc q (whiteExp κ hκ hKc q w)) :=
      (radialCutoff_contDiff a b).contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top)
    exact hcut.comp _ h1
  have hamb : ContDiffAt ℝ 2 (fun p' => whiteAmbientKernel κ hκ hKc τ p' q)
      (whiteExp κ hκ hKc q w) := by
    have h2 : ContDiffAt ℝ 2 (fun v : Point n => gaussDdim τ v)
        (whiteInvChart κ hκ hKc q (whiteExp κ hκ hKc q w)) :=
      (QIQTH.HeatParametrixOrder.gaussDdim_contDiff τ).contDiffAt.of_le le_top
    have h3 : ContDiffAt ℝ 2
        (fun p' => gaussDdim τ (whiteInvChart κ hκ hKc q p')) (whiteExp κ hκ hKc q w) :=
      h2.comp _ h1
    exact contDiffAt_const.mul h3
  have hf : ContDiffAt ℝ 2 (fun p' => whiteCutKernel κ hκ hKc a b τ p' q)
      (whiteExp κ hκ hKc q w) := hχ.mul hamb
  have hnat := hweld q hq w hw1 (fun p' => whiteCutKernel κ hκ hKc a b τ p' q) hf
  simp only [heatOp]
  have htime : (fun u => whiteCutKernel κ hκ hKc a b u (whiteExp κ hκ hKc q w) q)
      = (fun u => radialCutoff a b w
          * (Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim u w)) := by
    funext u
    simp only [whiteCutKernel, whiteAmbientKernel]
    rw [hval]
  have hlap : laplaceBeltrami (curvedRNCMetric κ) (curvedRNCInv κ)
      (fun p => whiteCutKernel κ hκ hKc a b τ p q) (whiteExp κ hκ hKc q w)
      = laplaceBeltrami (fun v => whitePullbackMetric κ hκ hKc q v)
          (fun v => whitePullbackMetricInv κ hκ hKc q v)
          (fun y => radialCutoff a b y
            * (Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y)) w := by
    rw [← hnat]
    refine QIQTH.VanVleckCancellation.laplaceBeltrami_congr_nhds _ _ _ _ w ?_
    filter_upwards [hgerm] with w' hw'
    show whiteCutKernel κ hκ hKc a b τ (whiteExp κ hκ hKc q w') q
        = radialCutoff a b w'
            * (Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w')
    simp only [whiteCutKernel, whiteAmbientKernel]
    rw [hw']
  rw [htime, hlap]

/-! ### 6. ★ THE CHART ANNULUS BOUND (the hann mechanism: Leibniz + exponential absorption). -/

/-- **★★ The chart annulus bound for the whitened cutoff kernel.**  On the gate annulus
    (`‖w‖ < r₀`, `a² ≤ rncRadialSq w`), for every `q ∈ K` and `τ > 0`:
        `|heatOp g^κ gi^κ (whiteCutKernel a b) τ (whiteExp_q w) q| ≤ C·G_{2τ}(w)`.
    Ledger: chart transfer (§5) + `C²` Leibniz split (`laplaceBeltrami_mul_C2`); the χ-slot pays
    the banked J4-623 amplitude bound; the `Δχ` slot pays `K₂` (§4) + the free width upgrade
    `G_τ ≤ √2ⁿ·G_{2τ}`; the cross-gradient pays `|∂W| ≤ c_max·(r₀/2)·(1/τ)·G_τ` + the
    EXPONENTIAL annulus absorption `(1/τ)·G_τ ≤ √2ⁿ·(8/a²)·G_{2τ}` (the banked tail trade —
    the `e^{−a²/·τ}` mechanism).  NOT `a₁ = R/6`. -/
theorem whiteCut_heatOp_annulus_chart (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (R : ℝ) (hKb : Kset ⊆ Metric.closedBall (0 : Point n) R) :
    ∃ r₀ > (0 : ℝ), ∀ a b : ℝ, 0 < a → a < b → ∃ C : ℝ, 0 ≤ C ∧
      ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ w : Point n, ‖w‖ < r₀ → a ^ 2 ≤ rncRadialSq w →
      |heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteCutKernel κ hκ hKc a b) τ
          (whiteExp κ hκ hKc q w) q|
        ≤ C * gaussDdim (2 * τ) w := by
  classical
  obtain ⟨r₁, hr₁0, htrans⟩ := whiteCut_heatOp_eq κ hκ hKc
  obtain ⟨r₂, hr₂0, Camp, hCamp0, hamp⟩ := whiteChart_heatOp_offdiag_bound_amp κ hκ hKc R hKb
  obtain ⟨r₃, hr₃0, hlapchi⟩ := whiteChart_lapChi_bound κ hκ hKc
  obtain ⟨r₄, hr₄0, Gb, hGb0, hgib⟩ := whiteInv_entry_bound κ hκ hKc
  set r₀ : ℝ := min (min r₁ r₂) (min r₃ r₄) with hr₀def
  have hr₀0 : 0 < r₀ := lt_min (lt_min hr₁0 hr₂0) (lt_min hr₃0 hr₄0)
  refine ⟨r₀, hr₀0, ?_⟩
  intro a b ha hab
  obtain ⟨K2, hK20, hK2⟩ := hlapchi a b
  obtain ⟨Kc1, hKc10, hKc1⟩ := pd_radialCutoff_bound_on_annulus_gen (n := n) a b a
    (Real.sqrt n * r₀)
  set cmax : ℝ := Real.sqrt ((1 - κ / 3 * ((n : ℝ) * R ^ 2)) ^ (n - 1)) with hcmaxdef
  have hcmax0 : 0 ≤ cmax := Real.sqrt_nonneg _
  have hS20 : 0 ≤ Real.sqrt 2 ^ n := pow_nonneg (Real.sqrt_nonneg _) n
  have h8a0 : 0 ≤ 8 / a ^ 2 := div_nonneg (by norm_num) (sq_nonneg a)
  have hr₀half0 : 0 ≤ r₀ / 2 := div_nonneg hr₀0.le (by norm_num)
  refine ⟨Camp + cmax * K2 * Real.sqrt 2 ^ n
      + 2 * (n : ℝ) ^ 2 * Gb * Kc1 * (cmax * (r₀ / 2)) * (Real.sqrt 2 ^ n * (8 / a ^ 2)),
    add_nonneg (add_nonneg hCamp0 (mul_nonneg (mul_nonneg hcmax0 hK20) hS20))
      (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by positivity) hGb0) hKc10)
        (mul_nonneg hcmax0 hr₀half0)) (mul_nonneg hS20 h8a0)), ?_⟩
  intro q hq τ hτ w hw hannw
  have hw1 : ‖w‖ < r₁ := lt_of_lt_of_le hw ((min_le_left _ _).trans (min_le_left _ _))
  have hw2 : ‖w‖ < r₂ := lt_of_lt_of_le hw ((min_le_left _ _).trans (min_le_right _ _))
  have hw3 : ‖w‖ < r₃ := lt_of_lt_of_le hw ((min_le_right _ _).trans (min_le_left _ _))
  have hw4 : ‖w‖ < r₄ := lt_of_lt_of_le hw ((min_le_right _ _).trans (min_le_right _ _))
  have hub : rncRadialSq w ≤ (Real.sqrt n * r₀) ^ 2 := by
    have h1 : rncRadialSq w ≤ (n : ℝ) * r₀ ^ 2 := by
      refine rncRadialSq_le_of_mem_closedBall (q := w) (r := r₀) ?_
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hw.le
    have h2 : (Real.sqrt n * r₀) ^ 2 = (n : ℝ) * r₀ ^ 2 := by
      rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg n)]
    linarith
  -- amplitude bookkeeping
  have hcd := curvedRNC_sqrtDet_bounds_on_ball κ hκ q (hKb hq)
  have hc0 : 0 ≤ Real.sqrt (Matrix.det (curvedRNCMetric κ q)) := Real.sqrt_nonneg _
  have hcle : Real.sqrt (Matrix.det (curvedRNCMetric κ q)) ≤ cmax := hcd.2
  -- Gaussian facts
  have hG0τ : 0 ≤ gaussDdim τ w := QIQTH.ResidueBound.gaussDdim_nonneg τ w
  have hG20 : 0 ≤ gaussDdim (2 * τ) w := QIQTH.ResidueBound.gaussDdim_nonneg _ w
  have hup : gaussDdim τ w ≤ Real.sqrt 2 ^ n * gaussDdim (2 * τ) w := by
    have h := gaussDdim_le_gaussDdim_chart (c := 1) (d := 2) one_pos two_pos hτ
      (v := w) (w := w) (by nlinarith [rncRadialSq_nonneg w])
    have e1 : ((2 : ℝ) / 1) = 2 := by norm_num
    rw [e1] at h
    simpa using h
  have htt : (1 / τ) * gaussDdim τ w
      ≤ (Real.sqrt 2 ^ n * (8 / a ^ 2)) * gaussDdim (2 * τ) w := by
    have h := invTpow_gaussDdim_le_width_annulus 1 a ha (c := 1) (d := 2)
      one_pos one_lt_two hτ hannw
    have e1 : ((2 : ℝ) / 1) = 2 := by norm_num
    have e2 : (4 * (1 : ℝ) * 2 / ((2 - 1) * a ^ 2)) = 8 / a ^ 2 := by
      rw [show ((2 : ℝ) - 1) = 1 from by norm_num]
      ring
    rw [e1, e2] at h
    simpa [pow_one, Nat.factorial_one, Nat.cast_one, mul_one, one_mul] using h
  -- rewrite through the transfer
  rw [htrans a b q hq τ hτ w hw1]
  -- time derivative: pull the τ-independent cutoff out
  rw [deriv_const_mul_field (radialCutoff a b w)]
  -- Leibniz split
  have hχC2 : ContDiffAt ℝ 2 (radialCutoff a b) w :=
    (radialCutoff_contDiff a b).contDiffAt.of_le (WithTop.coe_le_coe.mpr le_top)
  have hhC2 : ContDiffAt ℝ 2
      (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y) w :=
    contDiffAt_const.mul
      ((QIQTH.HeatParametrixOrder.gaussDdim_contDiff τ).contDiffAt.of_le le_top)
  have hgisymm : ∀ i j, whitePullbackMetricInv κ hκ hKc q w i j
      = whitePullbackMetricInv κ hκ hKc q w j i :=
    fun i j => whitePullbackMetricInv_symm_global κ hκ hKc q w i j
  have hlbmul := laplaceBeltrami_mul_C2 (fun v => whitePullbackMetric κ hκ hKc q v)
    (fun v => whitePullbackMetricInv κ hκ hKc q v) (radialCutoff a b)
    (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y) w
    hχC2 hhC2 hgisymm
  rw [hlbmul]
  -- abbreviations (goal-side abstractions)
  set Dv : ℝ := deriv (fun u => Real.sqrt (Matrix.det (curvedRNCMetric κ q))
    * gaussDdim u w) τ with hDvdef
  set Δh : ℝ := laplaceBeltrami (fun v => whitePullbackMetric κ hκ hKc q v)
    (fun v => whitePullbackMetricInv κ hκ hKc q v)
    (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y) w with hΔhdef
  set Δχ : ℝ := laplaceBeltrami (fun v => whitePullbackMetric κ hκ hKc q v)
    (fun v => whitePullbackMetricInv κ hκ hKc q v) (radialCutoff a b) w with hΔχdef
  set Sg : ℝ := ∑ i, ∑ j, whitePullbackMetricInv κ hκ hKc q w i j
    * pd (radialCutoff a b) i w
    * pd (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y) j w
    with hSgdef
  have heq : radialCutoff a b w * Dv
      - (radialCutoff a b w * Δh
        + Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ + 2 * Sg)
      = radialCutoff a b w * (Dv - Δh)
        - Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ - 2 * Sg := by
    ring
  rw [heq]
  have hsub2 : ∀ x y : ℝ, |x - y| ≤ |x| + |y| := fun x y => by
    rw [sub_eq_add_neg]
    exact (abs_add_le x (-y)).trans_eq (by rw [abs_neg])
  have htri : |radialCutoff a b w * (Dv - Δh)
      - Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ - 2 * Sg|
      ≤ |radialCutoff a b w * (Dv - Δh)|
        + |Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ|
        + |2 * Sg| := by
    have hA1 := hsub2 (radialCutoff a b w * (Dv - Δh)
      - Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ) (2 * Sg)
    have hA2 := hsub2 (radialCutoff a b w * (Dv - Δh))
      (Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ)
    linarith
  -- Term A: the χ-slot at the banked amplitude bound
  have hheat : heatOp (fun v => whitePullbackMetric κ hκ hKc q v)
      (fun v => whitePullbackMetricInv κ hκ hKc q v)
      (fun t x y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * flatPhaseModel t x y)
      τ w (0 : Point n) = Dv - Δh := by
    simp only [heatOp]
    have hK1 : (fun u => Real.sqrt (Matrix.det (curvedRNCMetric κ q))
        * flatPhaseModel u w (0 : Point n))
        = (fun u => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim u w) :=
      funext fun u => by rw [flatPhaseModel_zero_right]
    have hK2' : (fun p => Real.sqrt (Matrix.det (curvedRNCMetric κ q))
        * flatPhaseModel τ p (0 : Point n))
        = (fun p => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ p) :=
      funext fun p => by rw [flatPhaseModel_zero_right]
    rw [hK1, hK2', hDvdef, hΔhdef]
  have hA : |radialCutoff a b w * (Dv - Δh)| ≤ Camp * gaussDdim (2 * τ) w := by
    rw [abs_mul, ← hheat]
    have hχle : |radialCutoff a b w| ≤ 1 := by
      rw [abs_of_nonneg (radialCutoff_nonneg a b w)]
      exact radialCutoff_le_one a b w
    calc |radialCutoff a b w|
          * |heatOp (fun v => whitePullbackMetric κ hκ hKc q v)
              (fun v => whitePullbackMetricInv κ hκ hKc q v)
              (fun t x y => Real.sqrt (Matrix.det (curvedRNCMetric κ q))
                * flatPhaseModel t x y) τ w (0 : Point n)|
        ≤ 1 * (Camp * gaussDdim (2 * τ) w) :=
          mul_le_mul hχle (hamp q hq τ hτ w hw2) (abs_nonneg _) zero_le_one
      _ = Camp * gaussDdim (2 * τ) w := one_mul _
  -- Term B: the Δχ slot
  have hB : |Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ|
      ≤ cmax * K2 * Real.sqrt 2 ^ n * gaussDdim (2 * τ) w := by
    rw [abs_mul, abs_mul]
    have hΔχb : |Δχ| ≤ K2 := by
      rw [hΔχdef]
      exact hK2 q hq w hw3 hannw
    have hcabs : |Real.sqrt (Matrix.det (curvedRNCMetric κ q))| ≤ cmax := by
      rw [abs_of_nonneg hc0]
      exact hcle
    have hGabs : |gaussDdim τ w| ≤ Real.sqrt 2 ^ n * gaussDdim (2 * τ) w := by
      rw [abs_of_nonneg hG0τ]
      exact hup
    calc |Real.sqrt (Matrix.det (curvedRNCMetric κ q))| * |gaussDdim τ w| * |Δχ|
        ≤ cmax * (Real.sqrt 2 ^ n * gaussDdim (2 * τ) w) * K2 :=
          mul_le_mul (mul_le_mul hcabs hGabs (abs_nonneg _) hcmax0) hΔχb (abs_nonneg _)
            (mul_nonneg hcmax0 (mul_nonneg hS20 hG20))
      _ = cmax * K2 * Real.sqrt 2 ^ n * gaussDdim (2 * τ) w := by ring
  -- Term C: the cross-gradient with the exponential annulus absorption
  have hCc : |2 * Sg|
      ≤ 2 * (n : ℝ) ^ 2 * Gb * Kc1 * (cmax * (r₀ / 2))
          * (Real.sqrt 2 ^ n * (8 / a ^ 2)) * gaussDdim (2 * τ) w := by
    have hpdh : ∀ j : Fin n,
        |pd (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y) j w|
        ≤ (cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w) := by
      intro j
      rw [pd_const_mul (Real.sqrt (Matrix.det (curvedRNCMetric κ q)))
          (fun y => gaussDdim τ y) j w
          (PdiffAt_of_contDiff _ (QIQTH.HeatParametrixOrder.gaussDdim_contDiff τ) j w),
        gaussDdim_pd_eq τ hτ w j]
      rw [abs_mul, abs_mul]
      have hGabs : |gaussDdim τ w| = gaussDdim τ w := abs_of_nonneg hG0τ
      rw [hGabs]
      have h2t : (0 : ℝ) < 2 * τ := by linarith
      have h1 : |-(w j) / (2 * τ)| ≤ (r₀ / 2) * (1 / τ) := by
        rw [abs_div, abs_neg, abs_of_pos h2t]
        have hwj : |w j| ≤ r₀ := by
          have h := norm_le_pi_norm w j
          rw [Real.norm_eq_abs] at h
          linarith [hw.le]
        rw [div_le_iff₀ h2t]
        have he : (r₀ / 2) * (1 / τ) * (2 * τ) = r₀ := by field_simp
        rw [he]
        exact hwj
      have hcabs : |Real.sqrt (Matrix.det (curvedRNCMetric κ q))| ≤ cmax := by
        rw [abs_of_nonneg hc0]
        exact hcle
      calc |Real.sqrt (Matrix.det (curvedRNCMetric κ q))|
            * (|-(w j) / (2 * τ)| * gaussDdim τ w)
          ≤ cmax * (((r₀ / 2) * (1 / τ)) * gaussDdim τ w) :=
            mul_le_mul hcabs (mul_le_mul_of_nonneg_right h1 hG0τ)
              (mul_nonneg (abs_nonneg _) hG0τ) hcmax0
        _ = (cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w) := by ring
    have hterm : ∀ i j : Fin n,
        |whitePullbackMetricInv κ hκ hKc q w i j * pd (radialCutoff a b) i w
          * pd (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ y) j w|
        ≤ Gb * Kc1 * ((cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w)) := by
      intro i j
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul (hgib q hq w hw4 i j) (hKc1 w i hannw hub)
          (abs_nonneg _) hGb0) (hpdh j) (abs_nonneg _) (mul_nonneg hGb0 hKc10)
    have hSg : |Sg| ≤ (n : ℝ) ^ 2
        * (Gb * Kc1 * ((cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w))) := by
      rw [hSgdef]
      calc |∑ i, ∑ j, whitePullbackMetricInv κ hκ hKc q w i j
            * pd (radialCutoff a b) i w
            * pd (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q))
                * gaussDdim τ y) j w|
          ≤ ∑ i, ∑ j, |whitePullbackMetricInv κ hκ hKc q w i j
              * pd (radialCutoff a b) i w
              * pd (fun y => Real.sqrt (Matrix.det (curvedRNCMetric κ q))
                  * gaussDdim τ y) j w| :=
            (Finset.abs_sum_le_sum_abs _ _).trans
              (Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _)
        _ ≤ ∑ _i : Fin n, ∑ _j : Fin n,
              Gb * Kc1 * ((cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w)) :=
            Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hterm i j
        _ = (n : ℝ) ^ 2 * (Gb * Kc1 * ((cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w))) := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            ring
    have hmul : Gb * Kc1 * ((cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w))
        ≤ Gb * Kc1 * ((cmax * (r₀ / 2))
            * ((Real.sqrt 2 ^ n * (8 / a ^ 2)) * gaussDdim (2 * τ) w)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left htt (mul_nonneg hcmax0 hr₀half0))
        (mul_nonneg hGb0 hKc10)
    calc |2 * Sg| = 2 * |Sg| := by rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      _ ≤ 2 * ((n : ℝ) ^ 2
            * (Gb * Kc1 * ((cmax * (r₀ / 2)) * ((1 / τ) * gaussDdim τ w)))) := by
          have := hSg
          nlinarith [hSg]
      _ ≤ 2 * ((n : ℝ) ^ 2 * (Gb * Kc1 * ((cmax * (r₀ / 2))
            * ((Real.sqrt 2 ^ n * (8 / a ^ 2)) * gaussDdim (2 * τ) w)))) := by
          have h := mul_le_mul_of_nonneg_left hmul (by positivity : (0 : ℝ) ≤ (n : ℝ) ^ 2)
          linarith
      _ = 2 * (n : ℝ) ^ 2 * Gb * Kc1 * (cmax * (r₀ / 2))
            * (Real.sqrt 2 ^ n * (8 / a ^ 2)) * gaussDdim (2 * τ) w := by ring
  calc |radialCutoff a b w * (Dv - Δh)
        - Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ - 2 * Sg|
      ≤ |radialCutoff a b w * (Dv - Δh)|
        + |Real.sqrt (Matrix.det (curvedRNCMetric κ q)) * gaussDdim τ w * Δχ|
        + |2 * Sg| := htri
    _ ≤ Camp * gaussDdim (2 * τ) w
        + cmax * K2 * Real.sqrt 2 ^ n * gaussDdim (2 * τ) w
        + 2 * (n : ℝ) ^ 2 * Gb * Kc1 * (cmax * (r₀ / 2))
            * (Real.sqrt 2 ^ n * (8 / a ^ 2)) * gaussDdim (2 * τ) w :=
        add_le_add (add_le_add hA hB) hCc
    _ = (Camp + cmax * K2 * Real.sqrt 2 ^ n
          + 2 * (n : ℝ) ^ 2 * Gb * Kc1 * (cmax * (r₀ / 2))
              * (Real.sqrt 2 ^ n * (8 / a ^ 2))) * gaussDdim (2 * τ) w := by ring

/-! ### 7. The honest width and the displacement widening. -/

/-- The honest ambient width of the whitened producer: `λ = 2(n·C₀² + 1)` at the banked opaque
    tube-confinement constant. -/
noncomputable def whiteLam (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) : ℝ :=
  2 * ((n : ℝ) * (uniformFlowConst (curvedRNCMetric κ) (curvedRNCInv κ)
      (curvedRNC_hChr κ hκ) hKc) ^ 2 + 1)

theorem whiteLam_ge_two (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) : (2 : ℝ) ≤ whiteLam κ hκ hKc := by
  have h1 : (0 : ℝ) ≤ (n : ℝ) * (uniformFlowConst (curvedRNCMetric κ) (curvedRNCInv κ)
      (curvedRNC_hChr κ hκ) hKc) ^ 2 :=
    mul_nonneg (Nat.cast_nonneg n) (sq_nonneg _)
  show (2 : ℝ) ≤ 2 * ((n : ℝ) * (uniformFlowConst (curvedRNCMetric κ) (curvedRNCInv κ)
      (curvedRNC_hChr κ hκ) hKc) ^ 2 + 1)
  nlinarith

/-- **The displacement widening** — on a uniform gate the chart-velocity width-2 Gaussian is
    dominated by the ambient width-`whiteLam` Gaussian at the displacement `whiteExp_q w − q`
    (tube confinement + whitening `rncRadialSq` contraction + the banked width transfer). -/
theorem white_disp_gauss_le (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) :
    ∃ r₀ > (0 : ℝ), ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ w : Point n, ‖w‖ < r₀ →
      gaussDdim (2 * τ) w
        ≤ Real.sqrt (whiteLam κ hκ hKc / 2) ^ n
            * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q) := by
  classical
  set C₀ : ℝ := uniformFlowConst (curvedRNCMetric κ) (curvedRNCInv κ)
    (curvedRNC_hChr κ hκ) hKc with hC₀def
  have hC₀0 : 0 ≤ C₀ := uniformFlowConst_nonneg _ _ _ _
  set Rf : ℝ := uniformFlowRadius (curvedRNCMetric κ) (curvedRNCInv κ)
    (curvedRNC_hChr κ hκ) hKc with hRfdef
  have hRf0 : 0 < Rf := uniformFlowRadius_pos _ _ _ _
  have hsn : (0 : ℝ) ≤ Real.sqrt n := Real.sqrt_nonneg _
  have hlam_eq : whiteLam (n := n) κ hκ hKc = 2 * ((n : ℝ) * C₀ ^ 2 + 1) := rfl
  have hlam2 : (2 : ℝ) ≤ whiteLam (n := n) κ hκ hKc := whiteLam_ge_two κ hκ hKc
  refine ⟨Rf / (Real.sqrt n + 1), by positivity, ?_⟩
  intro q hq τ hτ w hw
  have hvRf : ‖whiteVel κ q w‖ ≤ Rf := by
    have h1 : ‖whiteVel κ q w‖ ≤ Real.sqrt n * ‖w‖ := whiteVel_norm_le κ hκ q w
    have h2 : ‖w‖ < Rf / (Real.sqrt n + 1) := hw
    have h3 : Real.sqrt n * ‖w‖ ≤ (Real.sqrt n + 1) * ‖w‖ :=
      mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)
    have h4 : (Real.sqrt n + 1) * ‖w‖ < (Real.sqrt n + 1) * (Rf / (Real.sqrt n + 1)) :=
      mul_lt_mul_of_pos_left h2 (by positivity)
    have h5 : (Real.sqrt n + 1) * (Rf / (Real.sqrt n + 1)) = Rf := by field_simp
    linarith
  have hdisp : ‖whiteExp κ hκ hKc q w - q‖ ≤ C₀ * ‖whiteVel κ q w‖ :=
    whiteExp_displacement κ hκ hKc q hq w hvRf
  have hr2disp : rncRadialSq (whiteExp κ hκ hKc q w - q)
      ≤ (n : ℝ) * C₀ ^ 2 * rncRadialSq w := by
    have h1 : rncRadialSq (whiteExp κ hκ hKc q w - q)
        ≤ (n : ℝ) * ‖whiteExp κ hκ hKc q w - q‖ ^ 2 := by
      refine rncRadialSq_le_of_mem_closedBall
        (q := whiteExp κ hκ hKc q w - q) (r := ‖whiteExp κ hκ hKc q w - q‖) ?_
      rw [Metric.mem_closedBall, dist_zero_right]
    have h2 : ‖whiteExp κ hκ hKc q w - q‖ ^ 2 ≤ (C₀ * ‖whiteVel κ q w‖) ^ 2 := by
      have := mul_self_le_mul_self (norm_nonneg _) hdisp
      nlinarith
    have h3 : ‖whiteVel κ q w‖ ^ 2 ≤ rncRadialSq (whiteVel κ q w) := by
      have hle : ‖whiteVel κ q w‖ ≤ rncRadial (whiteVel κ q w) :=
        norm_le_rncRadial (whiteVel κ q w)
      have hsq : rncRadial (whiteVel κ q w) ^ 2 = rncRadialSq (whiteVel κ q w) := by
        rw [rncRadial, Real.sq_sqrt (rncRadialSq_nonneg _)]
      have := mul_self_le_mul_self (norm_nonneg _) hle
      nlinarith [this, hsq]
    have h4 : rncRadialSq (whiteVel κ q w) ≤ rncRadialSq w := whiteVel_radialSq_le κ hκ q w
    have hn0 : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    nlinarith [h1, h2, h3, h4, sq_nonneg C₀]
  have hnorm : 2 * rncRadialSq (whiteExp κ hκ hKc q w - q)
      ≤ whiteLam (n := n) κ hκ hKc * rncRadialSq w := by
    rw [hlam_eq]
    have h0 : (0 : ℝ) ≤ rncRadialSq w := rncRadialSq_nonneg w
    nlinarith [hr2disp]
  exact gaussDdim_le_gaussDdim_chart (by norm_num) (by linarith) hτ hnorm

/-! ### 8. ★ THE HANN BOUND (leg (iv), displacement shape) + the explicit-width producer. -/

/-- **★★ J4-626 — `white_hann_bound`: the leg-(iv) annulus bound at the whitened cutoff kernel,
    displacement shape.**  ONE gate radius (independent of the cutoff radii); for every cutoff
    pair `0 < a < b` a constant `C ≥ 0` with, on the gate annulus,
        `|heatOp g^κ gi^κ (whiteCutKernel a b) τ (whiteExp_q w) q|
            ≤ C·G_{λτ}(whiteExp_q w − q)`,  `λ = whiteLam = 2(n·C₀²+1)`.
    = the chart annulus bound (§6, exponential absorption paid) pushed through the displacement
    widening (§7).  NOT `a₁ = R/6`. -/
theorem white_hann_bound (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (R : ℝ) (hKb : Kset ⊆ Metric.closedBall (0 : Point n) R) :
    ∃ r₀ > (0 : ℝ), ∀ a b : ℝ, 0 < a → a < b → ∃ C : ℝ, 0 ≤ C ∧
      ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ w : Point n, ‖w‖ < r₀ → a ^ 2 ≤ rncRadialSq w →
      |heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteCutKernel κ hκ hKc a b) τ
          (whiteExp κ hκ hKc q w) q|
        ≤ C * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q) := by
  obtain ⟨r₁, hr₁0, hchart⟩ := whiteCut_heatOp_annulus_chart κ hκ hKc R hKb
  obtain ⟨r₂, hr₂0, hdispG⟩ := white_disp_gauss_le κ hκ hKc
  refine ⟨min r₁ r₂, lt_min hr₁0 hr₂0, ?_⟩
  intro a b ha hab
  obtain ⟨C, hC0, hbd⟩ := hchart a b ha hab
  refine ⟨C * Real.sqrt (whiteLam κ hκ hKc / 2) ^ n,
    mul_nonneg hC0 (pow_nonneg (Real.sqrt_nonneg _) n), ?_⟩
  intro q hq τ hτ w hw hann
  calc |heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteCutKernel κ hκ hKc a b) τ
        (whiteExp κ hκ hKc q w) q|
      ≤ C * gaussDdim (2 * τ) w :=
        hbd q hq τ hτ w (lt_of_lt_of_le hw (min_le_left _ _)) hann
    _ ≤ C * (Real.sqrt (whiteLam κ hκ hKc / 2) ^ n
          * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q)) :=
        mul_le_mul_of_nonneg_left
          (hdispG q hq τ hτ w (lt_of_lt_of_le hw (min_le_right _ _))) hC0
    _ = C * Real.sqrt (whiteLam κ hκ hKc / 2) ^ n
          * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q) := by ring

/-- The J4-624 ambient producer bound restated at the EXPLICIT width `whiteLam` (the banked
    chart-velocity bound + the same displacement widening) — the `hbd` slot of the package at
    the same width the hann bound serves. -/
theorem white_ambient_bound_displacement_lam (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (R : ℝ) (hKb : Kset ⊆ Metric.closedBall (0 : Point n) R) :
    ∃ r₀ > (0 : ℝ), ∃ C : ℝ, 0 ≤ C ∧ ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ w : Point n, ‖w‖ < r₀ →
      |heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteAmbientKernel κ hκ hKc) τ
          (whiteExp κ hκ hKc q w) q|
        ≤ C * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q) := by
  obtain ⟨r₁, hr₁0, C, hC0, hbd⟩ := white_ambient_heatOp_bound κ hκ hKc R hKb
  obtain ⟨r₂, hr₂0, hdispG⟩ := white_disp_gauss_le κ hκ hKc
  refine ⟨min r₁ r₂, lt_min hr₁0 hr₂0, C * Real.sqrt (whiteLam κ hκ hKc / 2) ^ n,
    mul_nonneg hC0 (pow_nonneg (Real.sqrt_nonneg _) n), ?_⟩
  intro q hq τ hτ w hw
  calc |heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteAmbientKernel κ hκ hKc) τ
        (whiteExp κ hκ hKc q w) q|
      ≤ C * gaussDdim (2 * τ) w := hbd q hq τ hτ w (lt_of_lt_of_le hw (min_le_left _ _))
    _ ≤ C * (Real.sqrt (whiteLam κ hκ hKc / 2) ^ n
          * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q)) :=
        mul_le_mul_of_nonneg_left
          (hdispG q hq τ hτ w (lt_of_lt_of_le hw (min_le_right _ _))) hC0
    _ = C * Real.sqrt (whiteLam κ hκ hKc / 2) ^ n
          * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q) := by ring

/-! ### 9. The concrete fat gate. -/

/-- **The concrete flow-ball gate**: `S q = uniformFlowExp_q '' B(0,c)` — the uniform-chart
    flow ball (open by the banked W1 layer for `0 < c < δ₀`; contains `q = exp_q 0`). -/
noncomputable def whiteFlowGate (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (c : ℝ) : Point n → Set (Point n) :=
  fun q => uniformFlowExp (curvedRNCMetric κ) (curvedRNCInv κ) (curvedRNC_hChr κ hκ) hKc q
    '' Metric.ball 0 c

/-! ### 10. ★★ THE MILESTONE — the package fully discharged at the concrete fat gate. -/

/-- **★★★ J4-626 — `white_hpkgBound_discharged`: the J4-625 gating package FULLY DISCHARGED.**
    For every compact `K ⊆ B̄(0,R)` there ARE a gate `S` (OPEN with `q ∈ S q` at every `q ∈ K` —
    genuinely fat, no `S = ∅` degeneracy), cutoff radii `0 < a < b`, a constant `C ≥ 0` and a
    width `lam ≥ 2` such that the whitened gated witness obeys the FULL unconstrained `∀ (p,q)`
    capstone-`hpkgBound` SHAPE
        `∀ t' τ p q, 0 < τ → τ ≤ t' → |heatOp g^κ gi^κ (whiteGatedWitness S a b) τ p q|
            ≤ (C·(1+t'))·baseKernelW lam 0 τ p q`
    — UNCONDITIONALLY (legs (i)–(iii) discharged at the flow-ball gate, leg (iv) = the hann
    annulus bound of §8).  ⚠ HONEST WIDTH: `lam = whiteLam = 2(n·C₀²+1)`, NOT the literal `2`
    (the J4-625 R2 residue stands).  NOT `a₁ = R/6`. -/
theorem white_hpkgBound_discharged (κ : ℝ) (hκ : κ ≤ 0) {Kset : Set (Point n)}
    (hKc : IsCompact Kset) (R : ℝ) (hKb : Kset ⊆ Metric.closedBall (0 : Point n) R) :
    ∃ S : Point n → Set (Point n), ∃ a b : ℝ, 0 < a ∧ a < b
      ∧ (∀ q ∈ Kset, q ∈ S q ∧ IsOpen (S q))
      ∧ ∃ C : ℝ, 0 ≤ C ∧ ∃ lam : ℝ, 2 ≤ lam ∧
        ∀ t' τ : ℝ, ∀ p q : Point n, 0 < τ → τ ≤ t' →
          |heatOp (curvedRNCMetric κ) (curvedRNCInv κ)
              (whiteGatedWitness κ hκ hKc S a b) τ p q|
            ≤ (C * (1 + t')) * QIQTH.GaussianWidthTolerant.baseKernelW lam 0 τ p q := by
  classical
  obtain ⟨δ₀, hδ₀0, hspec⟩ := uniformInverseChart_huniformChart (curvedRNCMetric κ)
    (curvedRNCInv κ) (curvedRNC_hChr κ hκ) hKc
  obtain ⟨rh, hrh0, hhann⟩ := white_hann_bound κ hκ hKc R hKb
  obtain ⟨rp, hrp0, Cp, hCp0, hprod⟩ := white_ambient_bound_displacement_lam κ hκ hKc R hKb
  obtain ⟨CE, hCE0, hCEle⟩ := whiteUnvel_norm_le κ hκ hKc
  set r₀ : ℝ := min rh rp with hr₀def
  have hr₀0 : 0 < r₀ := lt_min hrh0 hrp0
  have hmin0 : 0 < min δ₀ (r₀ / (CE + 1)) :=
    lt_min hδ₀0 (div_pos hr₀0 (by linarith))
  set cg : ℝ := min δ₀ (r₀ / (CE + 1)) / 2 with hcgdef
  have hcg0 : 0 < cg := by
    rw [hcgdef]
    linarith
  have hcgδ : cg < δ₀ := by
    rw [hcgdef]
    have h1 : min δ₀ (r₀ / (CE + 1)) ≤ δ₀ := min_le_left _ _
    linarith
  have hcgr : CE * cg < r₀ := by
    have h2 : cg ≤ r₀ / (CE + 1) / 2 := by
      rw [hcgdef]
      have := min_le_right δ₀ (r₀ / (CE + 1))
      linarith
    have h3 : CE * cg ≤ CE * (r₀ / (CE + 1) / 2) := mul_le_mul_of_nonneg_left h2 hCE0
    have hx0 : 0 ≤ r₀ / (CE + 1) / 2 :=
      div_nonneg (div_nonneg hr₀0.le (by linarith)) (by norm_num)
    have h6 : CE * (r₀ / (CE + 1) / 2) ≤ (CE + 1) * (r₀ / (CE + 1) / 2) :=
      mul_le_mul_of_nonneg_right (by linarith) hx0
    have hne : CE + 1 ≠ 0 := by positivity
    have h5 : (CE + 1) * (r₀ / (CE + 1) / 2) = r₀ / 2 := by field_simp
    have h7 : r₀ / 2 < r₀ := by linarith
    linarith [h5 ▸ h6]
  have ha : 0 < cg / 4 := by linarith
  have hab : cg / 4 < cg / 2 := by linarith
  -- the chart-certificate leg (ii) at the flow-ball gate
  have key : ∀ q ∈ Kset, ∀ p ∈ whiteFlowGate κ hκ hKc cg q, ∃ w : Point n,
      p = whiteExp κ hκ hKc q w ∧ ‖w‖ < r₀ ∧ whiteInvChart κ hκ hKc q p = w
        ∧ ContinuousAt (fun p' => whiteInvChart κ hκ hKc q p') p := by
    intro q hq p hp
    obtain ⟨v, hvmem, hpv⟩ := hp
    have hv : ‖v‖ < cg := by rwa [mem_ball_zero_iff] at hvmem
    have hvδ : ‖v‖ < δ₀ := lt_trans hv hcgδ
    have hVval : uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ)
        (curvedRNC_hChr κ hκ) hKc q p = v := by
      rw [← hpv]
      exact (((hspec q hq).1 v hvδ).1).eq_of_nhds
    refine ⟨whiteUnvel κ q v, ?_, ?_, ?_, ?_⟩
    · rw [whiteExp_whiteUnvel κ hκ hKc q v]
      exact hpv.symm
    · calc ‖whiteUnvel κ q v‖ ≤ CE * ‖v‖ := hCEle q hq v
        _ ≤ CE * cg := mul_le_mul_of_nonneg_left hv.le hCE0
        _ < r₀ := hcgr
    · show whiteUnvel κ q (uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ)
          (curvedRNC_hChr κ hκ) hKc q p) = whiteUnvel κ q v
      rw [hVval]
    · have hC2 := ((hspec q hq).1 v hvδ).2
      have hCV : ContinuousAt (uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ)
          (curvedRNC_hChr κ hκ) hKc q) p := by
        rw [← hpv]
        exact hC2.continuousAt
      exact ((whiteUnvel κ q).continuous.continuousAt).comp hCV
  -- leg (i): openness + fatness
  have hSopen : ∀ q ∈ Kset, IsOpen (whiteFlowGate κ hκ hKc cg q) :=
    fun q hq => ((hspec q hq).2 cg hcg0 hcgδ).1
  have hfat : ∀ q ∈ Kset, q ∈ whiteFlowGate κ hκ hKc cg q
      ∧ IsOpen (whiteFlowGate κ hκ hKc cg q) := by
    intro q hq
    refine ⟨⟨0, mem_ball_zero_iff.mpr (by rw [norm_zero]; exact hcg0), ?_⟩, hSopen q hq⟩
    exact uniformFlowExp_zero (curvedRNCMetric κ) (curvedRNCInv κ) (curvedRNC_hChr κ hκ)
      hKc q hq
  -- leg (iii): the frontier — interior-off or the cutoff zero collar
  have hfrontier : ∀ q ∈ Kset, ∀ p : Point n, p ∉ whiteFlowGate κ hκ hKc cg q →
      ({p' : Point n | p' ∉ whiteFlowGate κ hκ hKc cg q} ∈ nhds p)
      ∨ ({p' : Point n | (cg / 2) ^ 2
            ≤ rncRadialSq (whiteInvChart κ hκ hKc q p')} ∈ nhds p) := by
    intro q hq p hpS
    by_cases hcl : p ∈ closure (whiteFlowGate κ hκ hKc cg q)
    · right
      have hsub := ((hspec q hq).2 cg hcg0 hcgδ).2
      obtain ⟨v, hvmem, hpv⟩ := hsub hcl
      have hvle : ‖v‖ ≤ cg := by rwa [Metric.mem_closedBall, dist_zero_right] at hvmem
      have hvδ : ‖v‖ < δ₀ := lt_of_le_of_lt hvle hcgδ
      have hVval : uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ)
          (curvedRNC_hChr κ hκ) hKc q p = v := by
        rw [← hpv]
        exact (((hspec q hq).1 v hvδ).1).eq_of_nhds
      have hval : whiteInvChart κ hκ hKc q p = whiteUnvel κ q v := by
        show whiteUnvel κ q (uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ)
            (curvedRNC_hChr κ hκ) hKc q p) = whiteUnvel κ q v
        rw [hVval]
      have hvc : ‖v‖ = cg := by
        by_contra hne
        have hlt : ‖v‖ < cg := lt_of_le_of_ne hvle hne
        exact hpS ⟨v, mem_ball_zero_iff.mpr hlt, hpv⟩
      have h3 : rncRadialSq v ≤ rncRadialSq (whiteUnvel κ q v) := by
        have h4 := whiteVel_radialSq_le κ hκ q (whiteUnvel κ q v)
        rw [whiteVel_whiteUnvel κ hκ q v] at h4
        exact h4
      have h5 : ‖v‖ ^ 2 ≤ rncRadialSq v := by
        have h6 := norm_le_rncRadial v
        have h7 : rncRadial v ^ 2 = rncRadialSq v := by
          rw [rncRadial, Real.sq_sqrt (rncRadialSq_nonneg _)]
        nlinarith [norm_nonneg v]
      have hgt : (cg / 2) ^ 2 < rncRadialSq (whiteInvChart κ hκ hKc q p) := by
        rw [hval]
        have h8 : cg ^ 2 ≤ rncRadialSq (whiteUnvel κ q v) := by
          have : ‖v‖ ^ 2 ≤ rncRadialSq (whiteUnvel κ q v) := le_trans h5 h3
          rw [hvc] at this
          exact this
        nlinarith [hcg0]
      have hC2 := ((hspec q hq).1 v hvδ).2
      have hCV : ContinuousAt (uniformInverseChart (curvedRNCMetric κ) (curvedRNCInv κ)
          (curvedRNC_hChr κ hκ) hKc q) p := by
        rw [← hpv]
        exact hC2.continuousAt
      have hVc : ContinuousAt (fun p' => whiteInvChart κ hκ hKc q p') p :=
        ((whiteUnvel κ q).continuous.continuousAt).comp hCV
      have hrc : ContinuousAt (fun p' => rncRadialSq (whiteInvChart κ hκ hKc q p')) p :=
        (rncRadialSq_contDiff.continuous.continuousAt).comp hVc
      have hopen : {p' : Point n | (cg / 2) ^ 2
          < rncRadialSq (whiteInvChart κ hκ hKc q p')} ∈ nhds p :=
        hrc.preimage_mem_nhds (Ioi_mem_nhds hgt)
      refine Filter.mem_of_superset hopen fun p' hp' => ?_
      exact le_of_lt (show (cg / 2) ^ 2
        < rncRadialSq (whiteInvChart κ hκ hKc q p') from hp')
    · left
      have hopen : (closure (whiteFlowGate κ hκ hKc cg q))ᶜ ∈ nhds p :=
        (isClosed_closure.isOpen_compl).mem_nhds hcl
      exact Filter.mem_of_superset hopen
        (fun p' hp' hmem => hp' (subset_closure hmem))
  -- the (a,b)-instantiated hann + producer with the joint constant
  obtain ⟨Ch, hCh0, hhann'⟩ := hhann (cg / 4) (cg / 2) ha hab
  have hCB0 : 0 ≤ max Cp Ch := le_trans hCp0 (le_max_left _ _)
  have hbd : ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ w : Point n, ‖w‖ < r₀ →
      |heatOp (curvedRNCMetric κ) (curvedRNCInv κ) (whiteAmbientKernel κ hκ hKc) τ
          (whiteExp κ hκ hKc q w) q|
        ≤ max Cp Ch * gaussDdim (whiteLam κ hκ hKc * τ) (whiteExp κ hκ hKc q w - q) := by
    intro q hq τ hτ w hw
    refine (hprod q hq τ hτ w (lt_of_lt_of_le hw (min_le_right _ _))).trans ?_
    exact mul_le_mul_of_nonneg_right (le_max_left _ _)
      (QIQTH.ResidueBound.gaussDdim_nonneg _ _)
  have hann : ∀ q ∈ Kset, ∀ τ : ℝ, 0 < τ → ∀ p ∈ whiteFlowGate κ hκ hKc cg q,
      (cg / 4) ^ 2 ≤ rncRadialSq (whiteInvChart κ hκ hKc q p) →
      |heatOp (curvedRNCMetric κ) (curvedRNCInv κ)
          (whiteCutKernel κ hκ hKc (cg / 4) (cg / 2)) τ p q|
        ≤ max Cp Ch * gaussDdim (whiteLam κ hκ hKc * τ) (p - q) := by
    intro q hq τ hτ p hp hannp
    obtain ⟨w, hpw, hwr, hVw, _⟩ := key q hq p hp
    have hannw : (cg / 4) ^ 2 ≤ rncRadialSq w := by
      rw [← hVw]
      exact hannp
    have h := hhann' q hq τ hτ w (lt_of_lt_of_le hwr (min_le_left _ _)) hannw
    rw [hpw]
    refine h.trans ?_
    exact mul_le_mul_of_nonneg_right (le_max_right _ _)
      (QIQTH.ResidueBound.gaussDdim_nonneg _ _)
  refine ⟨whiteFlowGate κ hκ hKc cg, cg / 4, cg / 2, ha, hab, hfat,
    max Cp Ch, hCB0, whiteLam κ hκ hKc, whiteLam_ge_two κ hκ hKc, ?_⟩
  exact white_hpkgBound_of_gatePackage κ hκ hKc (whiteFlowGate κ hκ hKc cg)
    ha hab hCB0 hbd hSopen key hfrontier hann

/-! ### 11. Non-vacuity / adversarial gate (cp466 discipline). -/

/-- **★ The discharged-package witness gate** — at the genuinely curved fat witness (`n = 2`,
    `κ = −1`, `K = closedBall 0 2`): the DISCHARGED package holds with a gate that is open and
    fat at every `q ∈ K`, AND the SAME gated witness it bounds is STRICTLY POSITIVE on the
    origin diagonal at every `τ > 0` (the bounded object is nonzero — no `S = ∅` degeneracy);
    the ambient flat-phase pair at the same witness provably admits NO width-2 bound (the banked
    J4-621 pin, re-exported).  NOT `a₁ = R/6`. -/
theorem white_discharged_witness_gate :
    (∃ S : Point 2 → Set (Point 2), ∃ a b : ℝ, 0 < a ∧ a < b
      ∧ (∀ q ∈ Metric.closedBall (0 : Point 2) 2, q ∈ S q ∧ IsOpen (S q))
      ∧ (∃ C : ℝ, 0 ≤ C ∧ ∃ lam : ℝ, 2 ≤ lam ∧
          ∀ t' τ : ℝ, ∀ p q : Point 2, 0 < τ → τ ≤ t' →
            |heatOp (curvedRNCMetric (-1 : ℝ)) (curvedRNCInv (-1 : ℝ))
                (whiteGatedWitness (-1 : ℝ) (by norm_num)
                  (isCompact_closedBall (0 : Point 2) 2) S a b) τ p q|
              ≤ (C * (1 + t')) * QIQTH.GaussianWidthTolerant.baseKernelW lam 0 τ p q)
      ∧ (∀ τ : ℝ, 0 < τ →
          0 < whiteGatedWitness (-1 : ℝ) (by norm_num)
            (isCompact_closedBall (0 : Point 2) 2) S a b τ 0 0))
    ∧ (¬ ∃ C : ℝ, ∀ τ : ℝ, 0 < τ → τ ≤ 1 → ∀ p q : Point 2,
        |heatOp (curvedRNCMetric (-1 : ℝ)) (curvedRNCInv (-1 : ℝ))
            (fun t x y => flatPhaseModel t x y) τ p q|
          ≤ C * gaussDdim (2 * τ) (fun i => p i - q i)) := by
  constructor
  · obtain ⟨S, a, b, ha, hab, hfat, C, hC0, lam, hlam2, hpkg⟩ :=
      white_hpkgBound_discharged (-1 : ℝ) (by norm_num)
        (isCompact_closedBall (0 : Point 2) 2) 2 Set.Subset.rfl
    refine ⟨S, a, b, ha, hab, hfat, ⟨C, hC0, lam, hlam2, hpkg⟩, ?_⟩
    intro τ hτ
    have h0K : (0 : Point 2) ∈ Metric.closedBall (0 : Point 2) 2 :=
      Metric.mem_closedBall_self (by norm_num)
    have hS0 : (0 : Point 2) ∈ S 0 := (hfat 0 h0K).1
    rw [whiteGatedWitness_diag_eval (-1 : ℝ) (by norm_num)
      (isCompact_closedBall (0 : Point 2) 2) S ha hab τ h0K hS0]
    exact gaussDdim_pos τ hτ _
  · exact flatPhase_hpkgBound_fails_witness

end QIQTH.WhiteAnnulus

