theorem expJet5ValG_smul_h (g gi : Point n → Fin n → Fin n → ℝ)
    (hC : ∀ a b c, ContDiff ℝ (⊤ : WithTop ℕ∞) (fun y => christoffel g gi a b c y)) (p v : Point n)
    (Φ : ℝ → ((Point n × Point n) →L[ℝ] (Point n × Point n)))
    (hv : ‖v‖ ≤ expRho g gi hC p) (hΦcont : ContinuousOn Φ (Set.Icc (0 : ℝ) 1))
    (c : ℝ) (h k l m r : Point n) :
    expJet5ValG g gi hC p v Φ hv hΦcont (c • h) k l m r
      = c • expJet5ValG g gi hC p v Φ hv hΦcont h k l m r := by
  have hbridge := expJet5Val_congr g gi hC p v Φ
      (expJet2Curve g gi hC p v Φ hv hΦcont (c • h) k)
      (expJet2Curve g gi hC p v Φ hv hΦcont (c • h) l)
      (expJet2Curve g gi hC p v Φ hv hΦcont (c • h) m)
      (expJet2Curve g gi hC p v Φ hv hΦcont (c • h) r)
      (expJet2Curve g gi hC p v Φ hv hΦcont k l)
      (expJet2Curve g gi hC p v Φ hv hΦcont k m)
      (expJet2Curve g gi hC p v Φ hv hΦcont k r)
      (expJet2Curve g gi hC p v Φ hv hΦcont l m)
      (expJet2Curve g gi hC p v Φ hv hΦcont l r)
      (expJet2Curve g gi hC p v Φ hv hΦcont m r)
