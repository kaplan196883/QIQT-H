/-! ###############################################################################
    ### (C2·§H gauge) — `census_gauge`: `hgiMem` ∧ `hΓMem` from RNC geometry.
    ############################################################################### -/

/-- **★ `census_gauge`.**  The two RNC gauge census members `MemGaugeGi gi` (`g⁻¹(0)=δ`) and
    `MemGaugeGamma g gi` (`Γ(0)=0`) DISCHARGED from the base geometry facts already present in
    `a1_R6_from_labelled`: `hK0` (`0∈K`), `hframeK` (RNC frame on `K`), `hinvF` (inverse relation),
    `hdg0` (`∂g(0)=0`).  ⚠ NOT `a₁ = R/6`. -/
theorem census_gauge (g gi : Point n → Fin n → Fin n → ℝ) {K : Set (Point n)}
    (hK0 : (0 : Point n) ∈ K)
    (hframeK : ∀ q ∈ K, ∀ i j, g q i j = (if i = j then (1 : ℝ) else 0))
    (hinvF : ∀ y c d, (∑ σ, g y c σ * gi y σ d) = if c = d then 1 else 0)
    (hdg0 : ∀ a b e, pd (fun y => g y a b) e (0 : Point n) = 0) :
    MemGaugeGi (n := n) gi ∧ MemGaugeGamma (n := n) g gi :=
  ⟨QIQTH.DaLimCensusRecon.memGaugeGi_of_geometry g gi hK0 hframeK hinvF,
   QIQTH.DaLimCensusRecon.memGaugeGamma_of_hdg0 g gi hdg0⟩

/-! ###############################################################################
    ### (C2·§H ecombine) — `census_ecombine`: `hEcomb` from the six Da/Lap data facts.
    ############################################################################### -/

/-- **★ `census_ecombine`.**  The `E`-combination member `MemECombine g gi H F` DISCHARGED from the six
    per-`(m,u)` representation/integrability data (`hDa`,`hLap`,`hLapZ`,`hEZ`,`hLapS`,`hES`) already
    present in `a1_R6_from_labelled`, via `DaLimCensusRecon.memECombine_of_data`.  ⚠ NOT `a₁ = R/6`. -/
theorem census_ecombine (g gi : Point n → Fin n → Fin n → ℝ) (H F : ℝ → Point n → Point n → ℝ)
    (hDa : ∀ (m : ℕ) (u : ℝ), DaTrunc H F m u
        = ∫ s in (0)..(u - epsSeq m), ∫ z, deriv (fun r => H r 0 z) (u - s) * F s z 0)
    (hLap : ∀ (m : ℕ) (u : ℝ), LapTrunc g gi H F m u
        = ∫ s in (0)..(u - epsSeq m), ∫ z,
            laplaceBeltrami g gi (fun x => H (u - s) x z) 0 * F s z 0)
    (hLapZ : ∀ (u : ℝ), ∀ s : ℝ, Integrable
        (fun z => laplaceBeltrami g gi (fun x => H (u - s) x z) 0 * F s z 0) volume)
    (hEZ : ∀ (u : ℝ), ∀ s : ℝ, Integrable
        (fun z => heatOp g gi H (u - s) 0 z * F s z 0) volume)
    (hLapS : ∀ (m : ℕ) (u : ℝ), IntervalIntegrable
        (fun s => ∫ z, laplaceBeltrami g gi (fun x => H (u - s) x z) 0 * F s z 0)
        volume 0 (u - epsSeq m))
    (hES : ∀ (m : ℕ) (u : ℝ), IntervalIntegrable
        (fun s => ∫ z, heatOp g gi H (u - s) 0 z * F s z 0) volume 0 (u - epsSeq m)) :
    MemECombine g gi H F :=
  QIQTH.DaLimCensusRecon.memECombine_of_data g gi H F hDa hLap hLapZ hEZ hLapS hES

/-! ###############################################################################
    ### (C2·§H source) — `census_source`: `hFdom` (∃) ∧ `hFzero` from `dataLevi`/`hn`.
    ############################################################################### -/

/-- **★ `census_source`.**  The Levi source facts: the width-2 Gaussian domination `hFdom` (existential
    constant `C_L`, from `dataLevi.hFenv` via `hFdom_concrete`) and the nonpositive-time vanishing
    `hFzero` (from `hFzero_concrete`, needing `1 ≤ n`).  Both at `E := heatOp g gi Wit`,
    `F := leviSeries E`.  ⚠ NOT `a₁ = R/6`. -/
theorem census_source (g gi : Point n → Fin n → Fin n → ℝ)
    (hChr : ∀ a b c, ContDiff ℝ (⊤ : WithTop ℕ∞) (fun y => christoffel g gi a b c y))
    {K : Set (Point n)} (hK : IsCompact K) (S : Point n → Set (Point n)) (a b : ℝ)
    (CLevi T : ℝ) (hn : 1 ≤ n)
    (dataLevi : LeviSeriesLocalData
      (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) CLevi T) :
    (∃ C_L : ℝ, 0 ≤ C_L ∧ ∀ s : ℝ, 0 < s → s ≤ T → ∀ z y : Point n,
        |leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z y|
          ≤ C_L * gaussDdim (2 * s) (z - y))
    ∧ (∀ s : ℝ, s ≤ 0 → ∀ z y : Point n,
        leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z y = 0) :=
  ⟨QIQTH.DaLimEasyTranche.hFdom_concrete
      (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) CLevi T dataLevi,
   QIQTH.DaLimEasyTranche.hFzero_concrete g gi hChr hK S a b hn⟩

/-! ###############################################################################
    ### (C2·§H strip) — `census_strip`: `hIlo` ∧ `hIhi` from the heatOp domination.
    ############################################################################### -/

/-- **★ `census_strip`.**  The strip interval-integrabilities `hIlo`/`hIhi` (the `E·F` inner pairing
    on `[0,u−ε_m]` / `[u−ε_m,u]`) DISCHARGED from the width-`wA` heat-operator Gaussian bound
    (`hAdomHeat`), the width-2 Levi source domination (derived from `dataLevi`), the source vanishing,
    and the two strip measurabilities `hmeasLo`/`hmeasHi`.  Via `DaLimEasyTranche.hIlo/hIhi_concrete`.
    ⚠ NOT `a₁ = R/6`. -/
theorem census_strip (g gi : Point n → Fin n → Fin n → ℝ)
    (hChr : ∀ a b c, ContDiff ℝ (⊤ : WithTop ℕ∞) (fun y => christoffel g gi a b c y))
    {K : Set (Point n)} (hK : IsCompact K) (S : Point n → Set (Point n)) (a b : ℝ)
    (U : Set ℝ) (T wA CA CLevi : ℝ) (hn : 1 ≤ n)
    (hwA : 0 < wA) (hCA : 0 ≤ CA)
    (hUpos : ∀ u ∈ U, 0 < u) (hUT : ∀ u ∈ U, u ≤ T)
    (dataLevi : LeviSeriesLocalData
      (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) CLevi T)
    (hAdomHeat : ∀ τ : ℝ, 0 < τ → τ ≤ T → ∀ z : Point n,
        |heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b) τ 0 z|
          ≤ CA * gaussDdim (wA * τ) (0 - z))
    (hmeasLo : ∀ (m : ℕ), ∀ u ∈ U, AEStronglyMeasurable
        (fun s => ∫ z, heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b) (u - s) 0 z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        ((volume : Measure ℝ).restrict (Set.uIoc 0 (u - epsSeq m))))
    (hmeasHi : ∀ (m : ℕ), ∀ u ∈ U, AEStronglyMeasurable
        (fun s => ∫ z, heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b) (u - s) 0 z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        ((volume : Measure ℝ).restrict (Set.uIoc (u - epsSeq m) u))) :
    (∀ (m : ℕ), ∀ u ∈ U, IntervalIntegrable
        (fun s => ∫ z, heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b) (u - s) 0 z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        volume 0 (u - epsSeq m))
    ∧ (∀ (m : ℕ), ∀ u ∈ U, IntervalIntegrable
        (fun s => ∫ z, heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b) (u - s) 0 z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        volume (u - epsSeq m) u) := by
  obtain ⟨C_L, hCL0, hLdom⟩ := QIQTH.DaLimEasyTranche.hFdom_concrete
    (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) CLevi T dataLevi
  have hFdom0 : ∀ s : ℝ, 0 < s → s ≤ T → ∀ z : Point n,
      |leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0|
        ≤ C_L * gaussDdim (2 * s) z := fun s hs hsT z => by
    have h := hLdom s hs hsT z 0; rwa [sub_zero] at h
  have hFzero0 : ∀ s : ℝ, s ≤ 0 → ∀ z : Point n,
      leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0 = 0 :=
    fun s hs z => QIQTH.DaLimEasyTranche.hFzero_concrete g gi hChr hK S a b hn s hs z 0
  exact ⟨QIQTH.DaLimEasyTranche.hIlo_concrete g gi hChr hK S a b U T wA CA 2 C_L
           hwA hCA (by norm_num) hCL0 hUpos hUT hAdomHeat hFdom0 hFzero0 hmeasLo,
         QIQTH.DaLimEasyTranche.hIhi_concrete g gi hChr hK S a b U T wA CA 2 C_L
           hwA hCA (by norm_num) hCL0 hUpos hUT hAdomHeat hFdom0 hFzero0 hmeasHi⟩

/-! ###############################################################################
    ### (C2·§H adjacency) — `census_adj`: `MemAdjLo` ∧ `MemAdjHi` from the 2nd-deriv domination.
    ############################################################################### -/

/-- **★ `census_adj`.**  The adjacency interval-integrabilities `MemAdjLo`/`MemAdjHi` (the
    `witnessSecondXDeriv·F` pairing) DISCHARGED from the width-`wA2` second-`x`-derivative Gaussian
    bound (`hAdom2`), the width-2 Levi source domination (from `dataLevi`), the source vanishing, and
    the two second-derivative strip measurabilities `hmeas2Lo`/`hmeas2Hi`.  Via
    `DaLimEasyTranche.hII_lo/hII_hi_concrete`.  ⚠ NOT `a₁ = R/6`. -/
theorem census_adj (g gi : Point n → Fin n → Fin n → ℝ)
    (hChr : ∀ a b c, ContDiff ℝ (⊤ : WithTop ℕ∞) (fun y => christoffel g gi a b c y))
    {K : Set (Point n)} (hK : IsCompact K) (S : Point n → Set (Point n)) (a b : ℝ)
    (U : Set ℝ) (T wA2 CA2 CLevi : ℝ) (hn : 1 ≤ n)
    (hwA2 : 0 < wA2) (hCA2 : 0 ≤ CA2)
    (hUpos : ∀ u ∈ U, 0 < u) (hUT : ∀ u ∈ U, u ≤ T)
    (dataLevi : LeviSeriesLocalData
      (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) CLevi T)
    (hAdom2 : ∀ (i : Fin n) (τ : ℝ), 0 < τ → τ ≤ T → ∀ z : Point n,
        |witnessSecondXDeriv g gi hChr hK S a b i τ z| ≤ CA2 * gaussDdim (wA2 * τ) (0 - z))
    (hmeas2Lo : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, AEStronglyMeasurable
        (fun s => ∫ z, witnessSecondXDeriv g gi hChr hK S a b i (u - s) z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        ((volume : Measure ℝ).restrict (Set.uIoc 0 (u - epsSeq m))))
    (hmeas2Hi : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, AEStronglyMeasurable
        (fun s => ∫ z, witnessSecondXDeriv g gi hChr hK S a b i (u - s) z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        ((volume : Measure ℝ).restrict (Set.uIoc (u - epsSeq m) u))) :
    MemAdjLo (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z)
    ∧ MemAdjHi (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z) := by
  obtain ⟨C_L, hCL0, hLdom⟩ := QIQTH.DaLimEasyTranche.hFdom_concrete
    (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) CLevi T dataLevi
  have hFdom0 : ∀ s : ℝ, 0 < s → s ≤ T → ∀ z : Point n,
      |leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0|
        ≤ C_L * gaussDdim (2 * s) z := fun s hs hsT z => by
    have h := hLdom s hs hsT z 0; rwa [sub_zero] at h
  have hFzero0 : ∀ s : ℝ, s ≤ 0 → ∀ z : Point n,
      leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0 = 0 :=
    fun s hs z => QIQTH.DaLimEasyTranche.hFzero_concrete g gi hChr hK S a b hn s hs z 0
  exact ⟨QIQTH.DaLimEasyTranche.hII_lo_concrete g gi hChr hK S a b
           (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) U T wA2 CA2 2 C_L
           hwA2 hCA2 (by norm_num) hCL0 hUpos hUT hAdom2 hFdom0 hFzero0 hmeas2Lo,
         QIQTH.DaLimEasyTranche.hII_hi_concrete g gi hChr hK S a b
           (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) U T wA2 CA2 2 C_L
           hwA2 hCA2 (by norm_num) hCL0 hUpos hUT hAdom2 hFdom0 hFzero0 hmeas2Hi⟩

/-! ###############################################################################
    ### (C2·§E→§H interchange) — `census_interchange`: `MemInterchange` from the W2 family.
    ############################################################################### -/

/-- **★ `census_interchange`.**  The frozen-side second-order interchange census member
    `MemInterchange Wit F U pdpd` DISCHARGED from the §E W2 differentiation-under-∫ family
    (`V`,`hVopen`,`hV0`,`snb`,`hsnb`,`hQ1`,`hFmeas`,`hFint`,`hF'meas`,`bnd`,`hbdd`,`hbound`,`hdiff`)
    already present in `a1_R6_from_labelled`, via `SecondOrderInterchangeConcrete.witness_MemInterchange`.
    ⚠ NOT `a₁ = R/6`. -/
theorem census_interchange (g gi : Point n → Fin n → Fin n → ℝ)
    (hChr : ∀ a b c, ContDiff ℝ (⊤ : WithTop ℕ∞) (fun y => christoffel g gi a b c y))
    {K : Set (Point n)} (hK : IsCompact K) (S : Point n → Set (Point n)) (a b : ℝ) (U : Set ℝ)
    (V : Set (Point n)) (hVopen : IsOpen V) (hV0 : (0 : Point n) ∈ V)
    (snb : Set ℝ) (hsnb : snb ∈ 𝓝 (0 : ℝ))
    (hQ1 : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, ∀ y ∈ V,
        pd (fun x => heatConvFrozen (vanVleckGatedWitness g gi hChr hK S a b)
            (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) u
            (u - epsSeq m) x 0) i y
          = ∫ s in (0)..(u - epsSeq m),
              ∫ z, witnessFieldDeriv g gi hChr hK S a b i (u - s) y z
                * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
    (hFmeas : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, ∀ w : ℝ, AEStronglyMeasurable
        (fun s => ∫ z, witnessFieldDeriv g gi hChr hK S a b i (u - s)
            (Function.update (0 : Point n) i w) z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        (volume.restrict (Set.uIoc 0 (u - epsSeq m))))
    (hFint : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, IntervalIntegrable
        (fun s => ∫ z, witnessFieldDeriv g gi hChr hK S a b i (u - s) (0 : Point n) z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        volume 0 (u - epsSeq m))
    (hF'meas : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, AEStronglyMeasurable
        (fun s => ∫ z, witnessFieldDeriv2 g gi hChr hK S a b i (u - s) (0 : Point n) z
            * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
        (volume.restrict (Set.uIoc 0 (u - epsSeq m))))
    (bnd : ℕ → Fin n → ℝ → ℝ)
    (hbdd : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U,
        IntervalIntegrable (bnd m i) volume 0 (u - epsSeq m))
    (hbound : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, ∀ᵐ s ∂volume,
        s ∈ Set.uIoc 0 (u - epsSeq m) → ∀ w ∈ snb,
          ‖∫ z, witnessFieldDeriv2 g gi hChr hK S a b i (u - s)
              (Function.update (0 : Point n) i w) z
              * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0‖
            ≤ bnd m i s)
    (hdiff : ∀ (m : ℕ) (i : Fin n), ∀ u ∈ U, ∀ᵐ s ∂volume,
        s ∈ Set.uIoc 0 (u - epsSeq m) → ∀ w ∈ snb,
          HasDerivAt (fun w => ∫ z, witnessFieldDeriv g gi hChr hK S a b i (u - s)
              (Function.update (0 : Point n) i w) z
              * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0)
            (∫ z, witnessFieldDeriv2 g gi hChr hK S a b i (u - s)
              (Function.update (0 : Point n) i w) z
              * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0) w) :
    MemInterchange (vanVleckGatedWitness g gi hChr hK S a b)
        (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z) := by
  exact QIQTH.SecondOrderInterchangeConcrete.witness_MemInterchange g gi hChr hK S a b
    (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) (0 : ℝ) U
    V hVopen hV0 snb hsnb hQ1 hFmeas hFint hF'meas bnd hbdd hbound hdiff

/-! ###############################################################################
    ### (C2·§H lapfull) — `census_lapfull`: `hLapFull` from gauge+interchange+adj+sliver+hPd2conv.
    ############################################################################### -/

/-- **★★ `census_lapfull`.**  The untruncated Laplacian-comparison census member `MemLapFull` (a1's
    `hLapFull` binder) DISCHARGED via `GlobalRawBoundFacade.memLapFull_from_labelled` from the two
    gauge members, the frozen interchange member, the two adjacency integrabilities, the `√ε` sliver
    amplitudes `D0/D1/hbnd`, and the ONE labelled carry `hPd2conv`.  This is the flagship §H
    composition — it converts a1's raw `hLapFull` hypothesis into {gauge + interchange + adjacency +
    sliver} (all derivable/present) plus the labelled `hPd2conv`.  ⚠ NOT `a₁ = R/6`; carries the
    labelled `hPd2conv`. -/
theorem census_lapfull (g gi : Point n → Fin n → Fin n → ℝ)
    (hChr : ∀ a b c, ContDiff ℝ (⊤ : WithTop ℕ∞) (fun y => christoffel g gi a b c y))
    {K : Set (Point n)} (hK : IsCompact K) (S : Point n → Set (Point n)) (a b : ℝ) (U : Set ℝ)
    (hgi : MemGaugeGi (n := n) gi) (hΓ : MemGaugeGamma (n := n) g gi)
    (hInter : MemInterchange (vanVleckGatedWitness g gi hChr hK S a b)
        (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z))
    (hII_lo : MemAdjLo (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z))
    (hII_hi : MemAdjHi (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z))
    (D0 D1 : Fin n → ℝ) (hD0 : ∀ i, 0 ≤ D0 i) (hD1 : ∀ i, 0 ≤ D1 i)
    (hbnd : ∀ (i : Fin n) (m : ℕ), ∀ u ∈ U,
        |∫ s in (u - epsSeq m)..u, ∫ (z : Point n),
            witnessSecondXDeriv g gi hChr hK S a b i (u - s) z
              * leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b)) s z 0|
          ≤ D0 i * (2 * Real.sqrt (epsSeq m)) + D1 i * epsSeq m)
    (hPd2conv : ∀ u ∈ U, ∀ i : Fin n,
        Tendsto
          (fun m => pd (fun y => pd (fun x => heatConvFrozen
              (vanVleckGatedWitness g gi hChr hK S a b)
              (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) u
              (u - epsSeq m) x 0) i y) i 0)
          atTop (𝓝 (pd (fun y => pd (fun x => heatConv
              (vanVleckGatedWitness g gi hChr hK S a b)
              (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) u x 0) i y) i 0))) :
    MemLapFull g gi (vanVleckGatedWitness g gi hChr hK S a b)
        (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
        (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z) :=
  QIQTH.GlobalRawBoundFacade.memLapFull_from_labelled g gi
    (vanVleckGatedWitness g gi hChr hK S a b)
    (leviSeries (heatOp g gi (vanVleckGatedWitness g gi hChr hK S a b))) U
    (fun i τ z => witnessSecondXDeriv g gi hChr hK S a b i τ z)
    hgi hΓ hInter hII_lo hII_hi D0 D1 hD0 hD1 hbnd hPd2conv

end QIQTH.CensusSweepOne

